<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LedBalloon.App.ViewModels"
        x:Class="LedBalloon.App.Views.PickerDialog"
        Icon="/Assets/ledballoon.ico"
        Title="LedBalloon"
        Width="880" Height="660"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelBackground" Color="#F4F5F7" />
          <SolidColorBrush x:Key="PanelBorder" Color="#DFE1E5" />
          <SolidColorBrush x:Key="TileBackground" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PanelBackground" Color="#16181C" />
          <SolidColorBrush x:Key="PanelBorder" Color="#2A2E35" />
          <SolidColorBrush x:Key="TileBackground" Color="#22262C" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <!-- The tile is the whole item, so the selection has something to draw itself around. A
         ListBoxItem's default padding would put the highlight at a distance from what it marks. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <Border Padding="18" Background="{DynamicResource PanelBackground}">
    <DockPanel>

      <!-- Declared first so the way out keeps its room whatever the list does. -->
      <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
        <TextBlock Name="CountText" Classes="hint" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Name="CancelButton" Content="Cancel" Click="OnCancel" IsCancel="True" />
          <Button Name="AcceptButton" Content="Use this" Click="OnAccept" IsDefault="True"
                  AutomationProperties.AutomationId="PickerAccept" />
        </StackPanel>
      </DockPanel>

      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
        <TextBlock Name="TitleText" FontSize="21" FontWeight="SemiBold" />

        <!-- A hundred and eighty-seven effects is more than anyone scrolls. Typing is how a list
             this long is actually used, so the box has the focus when the window opens. -->
        <TextBox Name="FilterBox" PlaceholderText="Type to narrow the list"
                 AutomationProperties.AutomationId="PickerFilter" />
      </StackPanel>

      <ListBox Name="Tiles" SelectionMode="Single"
               AutomationProperties.AutomationId="PickerTiles"
               Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               DoubleTapped="OnAccept">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.DataTemplates>

          <!-- An effect: the stamp the segment editor already draws, at a size you can see a
               pattern in rather than a smear of colour. -->
          <DataTemplate DataType="vm:PickerOption">
            <Border Width="158" Padding="7" CornerRadius="6"
                    Background="{DynamicResource TileBackground}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
              <StackPanel Spacing="6">
                <Border Height="58" CornerRadius="3" ClipToBounds="True"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                  <Image Source="{Binding Preview}" Stretch="Fill"
                         RenderOptions.BitmapInterpolationMode="None" />
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" Height="30" />
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- A palette: the gradient at a size worth comparing against the one beside it. -->
          <DataTemplate DataType="vm:PaletteOption">
            <Border Width="158" Padding="7" CornerRadius="6"
                    Background="{DynamicResource TileBackground}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
              <StackPanel Spacing="6">
                <Border Height="58" CornerRadius="3"
                        Background="{Binding Gradient}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" />
                <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" Height="30" />
              </StackPanel>
            </Border>
          </DataTemplate>

        </ListBox.DataTemplates>
      </ListBox>

    </DockPanel>
  </Border>
</Window>
