<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LedBalloon.App.ViewModels"
        x:Class="LedBalloon.App.Views.ScheduleDialog"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/ledballoon.ico"
        Title="Schedule"
        Width="560" Height="620"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock Text="What the house does on its own" FontWeight="SemiBold" FontSize="16" />
      <TextBlock Classes="hint" TextWrapping="Wrap"
                 Text="These timers fire even if this app or this computer are off. Every line covers the whole house." />
      <Button Content="Add a timer" Margin="0,6,0,6"
              AutomationProperties.AutomationId="AddTimer"
              Command="{Binding AddScheduleEntryCommand}" />
    </StackPanel>

    <!-- Nothing here saves. A timetable is part of the description of the house, so it goes to the
         controllers when that does - one save, rather than a button here that looks like the save
         and is not. -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,10,0,0">
      <TextBlock Classes="hint" VerticalAlignment="Center" Margin="0,0,8,0"
                 Text="Saved with everything else."
                 IsVisible="{Binding ScheduleChanged}" />
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Done" Click="OnSave" IsDefault="True" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel>

        <TextBlock Classes="hint" Margin="0,8" TextWrapping="Wrap"
                   Text="Nothing is scheduled. The house will only do what it is told while somebody is telling it."
                   IsVisible="{Binding !Schedule.Count}" />

        <ItemsControl ItemsSource="{Binding Schedule}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ScheduleRow">
              <!-- One line: a timer is one sentence - on, when, what - and stacking it made four
                   timers look like four pages. The scene picker takes the room left over, so it is
                   the part that grows with the window. -->
              <Border Classes="card" Margin="0,0,0,4" Padding="8">
                <StackPanel Spacing="4">
                <DockPanel>

                  <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}"
                            VerticalAlignment="Center" Margin="0,0,4,0"
                            ToolTip.Tip="Whether this timer runs at all" />

                  <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Triggers}"
                            SelectedItem="{Binding Trigger}" Width="116"
                            VerticalAlignment="Center" />

                  <NumericUpDown DockPanel.Dock="Left" Value="{Binding Hour}" Minimum="0" Maximum="23"
                                 FormatString="00" ShowButtonSpinner="False" Width="48"
                                 VerticalAlignment="Center" Margin="4,0,0,0"
                                 IsVisible="{Binding IsClock}" />
                  <TextBlock DockPanel.Dock="Left" Text=":" VerticalAlignment="Center"
                             Margin="2,0" IsVisible="{Binding IsClock}" />
                  <NumericUpDown DockPanel.Dock="Left" Value="{Binding Minute}" Minimum="0" Maximum="59"
                                 FormatString="00" ShowButtonSpinner="False" Width="48"
                                 VerticalAlignment="Center" IsVisible="{Binding IsClock}" />

                  <!-- Segoe's "Delete" glyph, which is the trash can Explorer, Outlook, Teams
                       and Settings all delete with. Named explicitly because the app's text
                       font is Inter, and a private-use codepoint drawn in it is a blank box.
                       Fluent Icons is Windows 11, MDL2 Assets is the 10 fallback. -->
                  <Button DockPanel.Dock="Right" Padding="7,3" Margin="6,0,0,0"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Remove this timer"
                          AutomationProperties.AutomationId="RemoveTimer"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveScheduleEntryCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="&#xE74D;" FontSize="13"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                  </Button>

                  <!-- E8BD is "Repeat All", the nearest thing in the set to "this happens on a
                       rule". Beside the trash can rather than inside the picker, because what a
                       timer fires and when it is allowed to fire are two different questions. -->
                  <Button DockPanel.Dock="Right" Padding="7,3" Margin="6,0,0,0"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Which days, and between which dates"
                          AutomationProperties.AutomationId="TimerRule"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditTimerRuleCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="&#xE8BD;" FontSize="13"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                  </Button>

                  <!-- The chip first, because that is what the eye lands on in a list of names
                       that all begin with the same word. The switch has none: it is not a look,
                       and a grey box beside it would imply it was. -->
                  <ComboBox ItemsSource="{Binding Presets}"
                            SelectedItem="{Binding Preset}"
                            PlaceholderText="pick what it does"
                            VerticalAlignment="Center" Margin="8,0,0,0"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PresetChoice">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Width="34" Height="14" CornerRadius="3"
                                  VerticalAlignment="Center"
                                  Background="{Binding Swatch}"
                                  BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                  IsVisible="{Binding HasSwatch}" />
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                </DockPanel>

                <!-- Said on the row, not only behind the button: a timer that quietly does not fire
                     on a Tuesday is exactly the kind of thing nobody thinks to go and check. -->
                <TextBlock Classes="hint" Margin="28,0,0,0"
                           Text="{Binding Limits}"
                           IsVisible="{Binding IsLimited}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
