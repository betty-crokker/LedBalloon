<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LedBalloon.App.Views.ConfirmDialog"
        Title="LedBalloon"
        Width="430" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Border Padding="20" Background="{DynamicResource StatusBackground}">
    <StackPanel Spacing="12">

      <TextBlock Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Name="MessageText" TextWrapping="Wrap" Opacity="0.85" />

      <CheckBox Name="OptionBox" IsVisible="False" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
        <Button Name="CancelButton" Click="OnCancel" />
        <Button Name="AlternateButton" IsVisible="False" Click="OnAlternate" />
        <Button Name="AcceptButton" Click="OnAccept" />
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
