<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:vm="using:LedBalloon.App.ViewModels"
        xmlns:ctrl="using:LedBalloon.App.Controls"
        xmlns:layout="using:LedBalloon.Core.Layout"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="LedBalloon.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="LedBalloon"
        Width="1280" Height="820"
        MinWidth="1040" MinHeight="620">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelBackground" Color="#F4F5F7" />
          <SolidColorBrush x:Key="PanelBorder" Color="#DFE1E5" />
          <SolidColorBrush x:Key="StatusBackground" Color="#E9EBEF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PanelBackground" Color="#16181C" />
          <SolidColorBrush x:Key="PanelBorder" Color="#2A2E35" />
          <SolidColorBrush x:Key="StatusBackground" Color="#1A1D22" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.panelTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.block">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Status bar. The hardware lives down here once it is working. -->
    <Border DockPanel.Dock="Bottom" Padding="12,7"
            Background="{DynamicResource StatusBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="hint" Margin="12,0,0,0"
                   Text="{Binding ControllerSummary}" />
        <Border DockPanel.Dock="Right" Margin="12,0,0,0" Padding="7,1" CornerRadius="3"
                Background="#C9821B" IsVisible="{Binding HasUnsavedChanges}">
          <TextBlock Text="Unsaved changes" FontSize="12" Foreground="White" />
        </Border>
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>

      <!-- ================= STARTING: finding the controllers ================= -->
      <Border IsVisible="{Binding IsStartingMode}" Background="{DynamicResource PanelBackground}">
        <Border Classes="card" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="0" ClipToBounds="True" Background="{DynamicResource StatusBackground}">
          <StackPanel Spacing="0">

            <!-- The L-7 WLED, moored and strung with lights. Waiting for a controller to answer is
                 dead time; give it something to look at rather than a spinner on a blank card. -->
            <Image Source="avares://LedBalloon.App/Assets/airship.jpg"
                   Stretch="UniformToFill" Height="240" />

            <StackPanel Spacing="14" Margin="26">

            <TextBlock Text="LedBalloon" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Classes="hint"
                       Text="Your controllers hold the layout, so there is nothing to open — it just has to be found. This takes a few seconds." />

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4"
                         IsVisible="{Binding IsScanning}" />

            <ItemsControl ItemsSource="{Binding StartupSteps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Classes="hint" Margin="0,2" TextWrapping="Wrap" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Nothing answered: explain why that happens and offer both ways on. -->
            <StackPanel Spacing="10" IsVisible="{Binding StartupFoundNothing}">
              <TextBlock Classes="hint"
                         Text="Discovery uses mDNS, which does not cross subnets or most VPNs. If your controllers are on another part of the network, add one by address instead." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Look again" Command="{Binding ScanCommand}"
                        IsEnabled="{Binding !IsScanning}" />
                <TextBox Width="150" PlaceholderText="192.168.0.102" Text="{Binding ManualHost}" />
                <Button Content="Add by address" Command="{Binding AddManualCommand}" />
              </StackPanel>
              <Button Content="Continue without a controller"
                      Command="{Binding ContinueWithoutControllersCommand}"
                      HorizontalAlignment="Left" />
            </StackPanel>

            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <!-- ================= DESIGN: what color should things be ================= -->
      <DockPanel IsVisible="{Binding IsDesignMode}">

        <Border DockPanel.Dock="Top" Padding="14,10"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Setup" Command="{Binding GoToSetupCommand}" />

            <!-- Sync is what makes the rest of this row readable. The switch and the slider always
                 went straight to the hardware while a preset did not, and nothing said which was
                 which; now one control decides it for all of them. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        Margin="12,0" VerticalAlignment="Center">
              <Button Content="Send to the lights"
                      Command="{Binding SendPendingCommand}"
                      IsVisible="{Binding HasPendingChanges}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="Discard"
                      Command="{Binding DiscardPendingCommand}"
                      IsVisible="{Binding HasPendingChanges}" />
              <CheckBox Content="Sync" IsChecked="{Binding LiveSync}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <ToggleSwitch IsChecked="{Binding MasterOn}" OnContent="On" OffContent="Off" />
              <TextBlock Text="Brightness" VerticalAlignment="Center" Classes="hint" />
              <Slider Width="170" Minimum="0" Maximum="255"
                      Value="{Binding MasterBrightness}" VerticalAlignment="Center" />
              <TextBlock Classes="hint" VerticalAlignment="Center"
                         Text="{Binding SyncHint}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Color and presets. Wider than the setup sidebar, because a preset needs describing
             and the photo only has to be big enough to read. -->
        <Border DockPanel.Dock="Right" Width="420" Padding="14"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">

              <TextBlock Classes="panelTitle" Text="{Binding SelectionLabel}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="hint"
                         Text="Click a run on the photo to change just that one." />
              <Button Classes="block" Content="Back to the whole house"
                      Command="{Binding SelectWholeHouseCommand}"
                      IsVisible="{Binding SelectedSegment, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

              <TextBlock Classes="heading" Text="Presets" />
              <TextBlock Classes="hint"
                         Text="Every preset on every controller, in one list — it does not matter which one stores it. A preset is a whole controller's worth of settings: every run's colors, effect and palette, saved together." />

              <ComboBox ItemsSource="{Binding Presets}"
                        SelectedItem="{Binding SelectedPreset}"
                        DisplayMemberBinding="{Binding Name}"
                        PlaceholderText="Pick a preset to look at"
                        HorizontalAlignment="Stretch"
                        Margin="0,4,0,0" />

              <!-- No banner and no buttons: whether this has reached the lights is what the Sync
                   switch says, in one place, for everything on this panel. -->
              <StackPanel Spacing="8"
                          IsVisible="{Binding SelectedPreset, Converter={x:Static conv:ObjectConverters.IsNotNull}}">

                <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding PresetCoverage}" />

                <!-- What the preset actually does, which its name does not tell you. -->
                <ItemsControl ItemsSource="{Binding PresetDetails}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresetDetail">
                      <Border Classes="card" Margin="0,0,0,6" Padding="10">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding RunName}" FontWeight="SemiBold" FontSize="12"
                                     TextTrimming="CharacterEllipsis" />

                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="18" Height="18" CornerRadius="3"
                                    Background="{Binding PrimarySwatch}"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" />
                            <Border Width="18" Height="18" CornerRadius="3"
                                    Background="{Binding SecondarySwatch}"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                    IsVisible="{Binding HasSecondary}" />
                            <TextBlock Classes="hint" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                              <Run Text="effect " /><Run Text="{Binding Effect}" FontWeight="SemiBold" />
                            </TextBlock>
                          </StackPanel>

                          <TextBlock Classes="hint">
                            <Run Text="palette " /><Run Text="{Binding Palette}" /><Run Text="  ·  " /><Run Text="{Binding Motion}" />
                          </TextBlock>

                          <TextBlock Classes="hint" FontStyle="Italic" Opacity="0.55"
                                     Text="{Binding Fidelity}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="Effects LedBalloon knows are run properly, at the frame rate the controller is set to. The rest are stood in for by sliding the run's palette along it, which gets the colors right and the movement only roughly." />
              </StackPanel>

              <!-- Tuning one run by hand is the less common job, so it folds away. -->
              <!-- A swatch that opens the picker, rather than a picker that is always open:
                   most of the time the preset list is what is wanted and the wheel is just bulk. -->
              <TextBlock Classes="heading" Text="By hand" Margin="0,14,0,0" />

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Padding="6,4" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="22" Height="22" CornerRadius="4"
                            Background="{Binding PickedBrush}"
                            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" />
                    <TextBlock Text="Color" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button.Flyout>
                    <Flyout Placement="Bottom">
                      <ColorView Color="{Binding PickedColor, Mode=TwoWay}"
                                 IsAlphaEnabled="False"
                                 IsColorPaletteVisible="True"
                                 IsColorComponentsVisible="False" />
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>

              <StackPanel Spacing="4"
                          IsVisible="{Binding SelectedSegment, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <TextBlock Classes="hint" Margin="0,8,0,2" Text="Effect" />
                <ComboBox ItemsSource="{Binding SegmentEffects}"
                          SelectedItem="{Binding SegmentEffectChoice}"
                          PlaceholderText="Not reported yet"
                          HorizontalAlignment="Stretch" />

                <TextBlock Classes="hint" Margin="0,8,0,2" Text="Palette" />
                <ComboBox ItemsSource="{Binding SegmentPalettes}"
                          SelectedItem="{Binding SegmentPaletteChoice}"
                          PlaceholderText="Not reported yet"
                          HorizontalAlignment="Stretch" />
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </Border>

        <ctrl:HouseCanvas Project="{Binding Project}"
                          Photo="{Binding PhotoBytes, Converter={x:Static vm:Converters.PhotoBitmap}}"
                          LayoutRevision="{Binding LayoutRevision}"
                          SelectedSegment="{Binding SelectedSegment}"
                          ControllerStates="{Binding DisplayStates}"
                          Palettes="{Binding Palettes}"
                          EffectNames="{Binding EffectNames}"
                          FrameTimes="{Binding FrameTimes}"
                          IsDrawing="False"
                          SegmentPicked="OnSegmentPicked" />
      </DockPanel>

      <!-- ================= SETUP: describe the house ================= -->
      <DockPanel IsVisible="{Binding IsSetupMode}">

        <Border DockPanel.Dock="Top" Padding="14,10"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
          <DockPanel>
            <!-- Saving is a document-level action, so it belongs up here where it is always in
                 reach, not at the end of a long scroll. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
              <Border Padding="7,2" CornerRadius="3" Background="#C9821B" VerticalAlignment="Center"
                      IsVisible="{Binding HasUnsavedChanges}">
                <TextBlock Text="Unsaved" FontSize="12" Foreground="White" />
              </Border>
              <Button Content="Save to controllers"
                      Command="{Binding SaveProjectCommand}" IsEnabled="{Binding !IsBusy}" />
              <Button Content="Overwrite anyway"
                      Command="{Binding OverwriteNewerRevisionCommand}"
                      IsVisible="{Binding SaveBlockedByNewerRevision}" />
              <Button Content="Done — back to colors"
                      Command="{Binding FinishSetupCommand}"
                      IsEnabled="{Binding HasSegments}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Setting up the house" FontWeight="SemiBold" />
              <TextBlock Classes="hint"
                         Text="Controllers, runs and where they hang. Saving stores the layout on the controllers and re-cuts their segments to match." />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border DockPanel.Dock="Left" Width="320" Padding="14"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0">
          <!-- Picking a controller and a run stays put at the top, the two things you always want
               stay pinned at the bottom, and only the editor scrolls. Previously the whole column
               scrolled as one and Save ended up below the fold. -->
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="0">

              <TextBlock Classes="panelTitle" Text="Controller" Margin="0,0,0,6" />
              <TextBlock Classes="hint" Margin="0,0,0,6"
                         Text="Pick one. The runs below are the ones plugged into it." />

              <!-- A list, not a heading: choosing the controller is what filters everything under it. -->
              <ListBox ItemsSource="{Binding Coverage}"
                       SelectedItem="{Binding SelectedCoverage}"
                       Background="Transparent"
                       Margin="0,0,0,12">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ControllerCoverage">
                    <StackPanel Margin="0,3" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Classes="hint" Text="{Binding Summary}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Classes="panelTitle" Text="{Binding SegmentsHeading}" Margin="0,0,0,6"
                         TextTrimming="CharacterEllipsis" />

              <Button Classes="block" Margin="0,0,0,8" FontSize="12" Padding="6,3"
                      Content="Bring in its outputs as segments"
                      Command="{Binding ImportFromControllerCommand}" />

              <ListBox ItemsSource="{Binding SegmentRows}"
                       SelectedItem="{Binding SelectedRow}"
                       Background="Transparent"
                       MaxHeight="190"
                       IsVisible="{Binding HasVisibleSegments}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SegmentRow">
                    <StackPanel Margin="0,4" Spacing="2">
                      <TextBlock Text="{Binding Segment.Name}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="hint">
                        <Run Text="{Binding Segment.Count}" /><Run Text=" LEDs  ·  LED " /><Run Text="{Binding Segment.Start}" /><Run Text=" to " /><Run Text="{Binding Segment.StopExclusive}" />
                      </TextBlock>
                      <TextBlock Classes="hint" Foreground="#C9821B" FontSize="11"
                                 IsVisible="{Binding !Segment.HasGeometry}"
                                 Text="not traced on the photo yet" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Classes="hint" Margin="0,6,0,0"
                         IsVisible="{Binding !HasVisibleSegments}"
                         Text="Nothing described on this controller yet. Bring in its outputs above, or add a run by hand below." />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
              <Button Classes="block" Content="Add a run to this controller"
                      Command="{Binding AddSegmentCommand}" />
              <Button Classes="block" Content="Re-lay end to end"
                      Command="{Binding RepackSegmentsCommand}" />
            </StackPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
              <StackPanel Spacing="8">

                <!-- Overlaps and gaps, live. Changing a length is what creates them, so they are
                     reported here as it is typed rather than behind a button elsewhere. -->
                <Border Classes="card" Background="#33C9821B"
                        IsVisible="{Binding HasLayoutWarnings}">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Needs re-laying" FontWeight="SemiBold" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding LayoutWarnings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Classes="hint" Margin="0,1" Text="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="block" FontSize="12" Padding="6,3" Margin="0,4,0,0"
                            Content="Re-lay end to end"
                            Command="{Binding RepackSegmentsCommand}" />
                  </StackPanel>
                </Border>

                <Border Classes="card"
                        IsVisible="{Binding SelectedSegment, Converter={x:Static conv:ObjectConverters.IsNull}}">
                  <TextBlock Classes="hint"
                             Text="Pick a run in the list above to rename it, change its length, or remove it." />
                </Border>

              <!-- The editor is a template over the selected run, not a panel that hides itself.
                   IsVisible="False" still binds its children, so every field here evaluated
                   against a null segment whenever nothing was selected and logged a binding
                   error. With a template, no selection means nothing is built at all. -->
              <ContentControl Content="{Binding SelectedSegment}">
                <ContentControl.ContentTemplate>
                  <DataTemplate DataType="layout:Segment">
                    <Border Classes="card">
                      <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                          <Run Text="Editing:" /><Run Text=" " /><Run Text="{Binding Name}" />
                        </TextBlock>

                        <TextBlock Classes="hint" Text="Name" />
                        <TextBox Text="{Binding Name}" />

                        <Grid ColumnDefinitions="*,8,*">
                          <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="hint" Text="LEDs" />
                            <TextBox Text="{Binding Count}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Classes="hint" Text="Starts at" />
                            <TextBox Text="{Binding Start}" />
                          </StackPanel>
                        </Grid>

                        <TextBlock Classes="hint" Text="What kind of light" />
                        <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).FixtureStyles}"
                                  SelectedItem="{Binding $parent[Window].((vm:MainViewModel)DataContext).FixtureChoice}"
                                  PlaceholderText="Pick a fixture"
                                  HorizontalAlignment="Stretch" />

                        <StackPanel Spacing="4" IsVisible="{Binding Fixture.IsAimed}">
                          <TextBlock Classes="hint" Text="Beam spread" />
                          <Slider Minimum="10" Maximum="160" Value="{Binding Fixture.BeamAngleDegrees}" />
                          <TextBlock Classes="hint" Text="How far it reaches" />
                          <Slider Minimum="0.02" Maximum="0.6" Value="{Binding Fixture.ThrowLength}" />
                          <CheckBox Content="Aim the other way" IsChecked="{Binding Fixture.FlipAim}" />
                        </StackPanel>

                        <TextBlock Classes="hint" Text="A lens every N LEDs" />
                        <TextBox Text="{Binding Fixture.VisibleEvery}" />

                        <Button Classes="block" Content="Flip which end is LED 1"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FlipSegmentDirectionCommand}" />
                        <Button Classes="block" Content="Trace it on the photo"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RedrawSegmentCommand}" />
                        <TextBlock Classes="hint" Foreground="#C9821B"
                                   IsVisible="{Binding !HasGeometry}"
                                   Text="This run has no line on the photo yet, so it cannot be shown or clicked there." />

                        <TextBlock Classes="hint" Text="Driven by" />
                        <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).Devices}"
                                  SelectedItem="{Binding $parent[Window].((vm:MainViewModel)DataContext).SegmentController}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  PlaceholderText="Not assigned"
                                  HorizontalAlignment="Stretch" />

                        <Button Classes="block" Content="Remove this segment"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteSegmentCommand}"
                                Margin="0,4,0,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
                </ContentControl>

              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <TabControl Margin="14,8,14,8">

          <TabItem Header="The house">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="4,8">
                <Button Content="Load photo" Click="OnLoadPhoto" />
                <Button Content="Draw selected segment"
                        Command="{Binding StartDrawingSegmentCommand}"
                        IsEnabled="{Binding !IsDrawingSegment}" />
                <Button Content="Done drawing"
                        Command="{Binding FinishDrawingSegmentCommand}"
                        IsEnabled="{Binding IsDrawingSegment}" />
                <Border Padding="8,3" CornerRadius="3" Background="#2F7BD6" VerticalAlignment="Center"
                        IsVisible="{Binding IsDrawingSegment}">
                  <TextBlock Text="Drawing" FontSize="12" Foreground="White" />
                </Border>
              </StackPanel>

              <!-- Says what a click does now, which is not the same in both modes. -->
              <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="4,0,4,8"
                         Text="{Binding PhotoHint}" />

              <ctrl:HouseCanvas Project="{Binding Project}"
                                Photo="{Binding PhotoBytes, Converter={x:Static vm:Converters.PhotoBitmap}}"
                                LayoutRevision="{Binding LayoutRevision}"
                                SelectedSegment="{Binding SelectedSegment}"
                                ControllerStates="{Binding ControllerStates}"
                                IsDrawing="{Binding IsDrawingSegment}"
                                PointAdded="OnCanvasPointAdded"
                                SegmentPicked="OnSegmentPicked" />
            </DockPanel>
          </TabItem>

          <TabItem Header="Controllers">
            <ScrollViewer>
              <StackPanel Margin="8,8,8,16" Spacing="6">

                <TextBlock Classes="hint" Margin="0,8,0,0"
                           Text="Found over mDNS and filed by MAC address, so a controller that comes back on a different IP is still recognized." />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                  <Button Content="Scan the network" Command="{Binding ScanCommand}"
                          IsEnabled="{Binding !IsScanning}" />
                  <TextBox Width="180" PlaceholderText="192.168.0.102" Text="{Binding ManualHost}" />
                  <Button Content="Add by address" Command="{Binding AddManualCommand}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Devices}"
                         SelectedItem="{Binding SelectedDevice}"
                         Margin="0,8,0,0" MaxHeight="200">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceViewModel">
                      <StackPanel Spacing="2" Margin="0,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                   Fill="{Binding IsConnected, Converter={x:Static vm:Converters.ConnectionBrush}}" />
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Classes="hint">
                          <Run Text="{Binding Host}" /><Run Text="  ·  " /><Run Text="{Binding Status}" />
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Spacing="6" Margin="0,8,0,0"
                            IsVisible="{Binding SelectedDevice, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                  <TextBlock Classes="hint" Text="Name this controller" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="240" Text="{Binding ControllerNameEdit}" PlaceholderText="Front of house" />
                    <Button Content="Rename" Command="{Binding RenameControllerCommand}" />
                  </StackPanel>
                  <TextBlock Classes="hint"
                             Text="The name is stored in the layout on the controllers, and written to the controller's own settings so the WLED app agrees. If the device will not accept it — a settings PIN blocks this — LedBalloon keeps the name anyway and says so." />
                </StackPanel>

                <TextBlock Classes="heading" Text="Work the layout out from presets" />
                <TextBlock Classes="hint"
                           Text="Each preset on a controller stores its own copy of the segment bounds, so they can disagree. This weighs them against the hardware and asks you about the rest." />
                <Button Content="Work out layout from the selected controller's presets"
                        Command="{Binding ProposeLayoutCommand}" HorizontalAlignment="Left" />

                <TextBlock Classes="heading" Text="Health" />
                <Button Content="Check presets against the strips"
                        Command="{Binding AuditCommand}" HorizontalAlignment="Left" />

                <ItemsControl ItemsSource="{Binding PresetGaps}" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,2" TextWrapping="Wrap" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding LayoutProblems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,2" TextWrapping="Wrap" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding LayoutConflicts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,2" TextWrapping="Wrap" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </ScrollViewer>
          </TabItem>

        </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
