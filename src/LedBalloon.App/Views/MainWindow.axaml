<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:vm="using:LedBalloon.App.ViewModels"
        xmlns:ctrl="using:LedBalloon.App.Controls"
        xmlns:layout="using:LedBalloon.Core.Layout"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="LedBalloon.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="LedBalloon"
        Width="1280" Height="820"
        MinWidth="1040" MinHeight="620">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelBackground" Color="#F4F5F7" />
          <SolidColorBrush x:Key="PanelBorder" Color="#DFE1E5" />
          <SolidColorBrush x:Key="StatusBackground" Color="#E9EBEF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PanelBackground" Color="#16181C" />
          <SolidColorBrush x:Key="PanelBorder" Color="#2A2E35" />
          <SolidColorBrush x:Key="StatusBackground" Color="#1A1D22" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.panelTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.block">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- A run in the list marks itself as picked and does nothing else. It used to flash the
         theme's pressed shading, which read as a button that had done something and then thought
         better of it - when all it does is decide what the photo highlights and what Draw
         selected segment will trace. The pencil beside it is the thing that acts. -->
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <Style Selector="Button.row">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.row /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Status bar. The hardware lives down here once it is working. -->
    <Border DockPanel.Dock="Bottom" Padding="12,7"
            Background="{DynamicResource StatusBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="hint" Margin="12,0,0,0"
                   Text="{Binding ControllerSummary}" />
        <Border DockPanel.Dock="Right" Margin="12,0,0,0" Padding="7,1" CornerRadius="3"
                Background="#C9821B" IsVisible="{Binding HasUnsavedChanges}">
          <TextBlock Text="Unsaved changes" FontSize="12" Foreground="White" />
        </Border>
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>

      <!-- ================= STARTING: finding the controllers ================= -->
      <Border IsVisible="{Binding IsStartingMode}" Background="{DynamicResource PanelBackground}">
        <Border Classes="card" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="0" ClipToBounds="True" Background="{DynamicResource StatusBackground}">
          <StackPanel Spacing="0">

            <!-- The L-7 WLED, moored and strung with lights. Waiting for a controller to answer is
                 dead time; give it something to look at rather than a spinner on a blank card. -->
            <Image Source="avares://LedBalloon.App/Assets/airship.jpg"
                   Stretch="UniformToFill" Height="240" />

            <StackPanel Spacing="14" Margin="26">

            <TextBlock Text="LedBalloon" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Classes="hint"
                       Text="Your controllers hold the layout, so there is nothing to open — it just has to be found. This takes a few seconds." />

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4"
                         IsVisible="{Binding IsScanning}" />

            <ItemsControl ItemsSource="{Binding StartupSteps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Classes="hint" Margin="0,2" TextWrapping="Wrap" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Nothing answered: explain why that happens and offer both ways on. -->
            <StackPanel Spacing="10" IsVisible="{Binding StartupFoundNothing}">
              <TextBlock Classes="hint"
                         Text="Discovery uses mDNS, which does not cross subnets or most VPNs. If your controllers are on another part of the network, add one by address instead." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Look again" Command="{Binding ScanCommand}"
                        IsEnabled="{Binding !IsScanning}" />
                <TextBox Width="150" PlaceholderText="192.168.0.102" Text="{Binding ManualHost}" />
                <Button Content="Add by address" Command="{Binding AddManualCommand}" />
              </StackPanel>
              <Button Content="Continue without a controller"
                      Command="{Binding ContinueWithoutControllersCommand}"
                      HorizontalAlignment="Left" />
            </StackPanel>

            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <!-- ================= DESIGN: what color should things be ================= -->
      <DockPanel IsVisible="{Binding IsDesignMode}">

        <Border DockPanel.Dock="Top" Padding="14,10"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Setup" Command="{Binding GoToSetupCommand}" />

            <!-- Sync is what makes the rest of this row readable. The switch and the slider always
                 went straight to the hardware while a preset did not, and nothing said which was
                 which; now one control decides it for all of them. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        Margin="12,0" VerticalAlignment="Center">
              <Button Content="Send to the lights"
                      Command="{Binding SendPendingCommand}"
                      IsVisible="{Binding HasPendingChanges}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="Discard"
                      Command="{Binding DiscardPendingCommand}"
                      IsVisible="{Binding HasPendingChanges}" />
              <CheckBox Content="Sync" IsChecked="{Binding LiveSync}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <ToggleSwitch IsChecked="{Binding MasterOn}" OnContent="On" OffContent="Off" />
              <TextBlock Text="Brightness" VerticalAlignment="Center" Classes="hint" />
              <Slider Width="170" Minimum="0" Maximum="255"
                      Value="{Binding MasterBrightness}" VerticalAlignment="Center" />
              <TextBlock Classes="hint" VerticalAlignment="Center"
                         Text="{Binding SyncHint}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Color and presets. Wider than the setup sidebar, because a preset needs describing
             and the photo only has to be big enough to read. -->
        <Border DockPanel.Dock="Right" Width="420" Padding="14"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">

              <TextBlock Classes="panelTitle" Text="{Binding SelectionLabel}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="hint"
                         Text="Click a segment on the photo to change just that one." />
              <Button Classes="block" Content="Back to the whole house"
                      Command="{Binding SelectWholeHouseCommand}"
                      IsVisible="{Binding SelectedSegment, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

              <!-- The house changes on its own, so say so here rather than letting it look like
                   the app lost track of what it set. -->
              <Border Classes="card" Padding="8" Margin="0,4,0,0"
                      IsVisible="{Binding ScheduleNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="hint" Text="{Binding ScheduleNotice}" />
              </Border>

              <TextBlock Classes="heading" Text="Presets" />
              <TextBlock Classes="hint"
                         Text="Every preset on every controller, in one list — it does not matter which one stores it. A preset is a whole controller's worth of settings: every segment's colors, effect and palette, saved together." />

              <ComboBox ItemsSource="{Binding Presets}"
                        SelectedItem="{Binding SelectedPreset}"
                        DisplayMemberBinding="{Binding Name}"
                        PlaceholderText="Pick a preset to look at"
                        HorizontalAlignment="Stretch"
                        Margin="0,4,0,0" />

              <!-- No banner and no buttons: whether this has reached the lights is what the Sync
                   switch says, in one place, for everything on this panel. -->
              <StackPanel Spacing="8"
                          IsVisible="{Binding SelectedPreset, Converter={x:Static conv:ObjectConverters.IsNotNull}}">

                <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding PresetCoverage}" />

                <!-- What the preset actually does, which its name does not tell you. -->
                <ItemsControl ItemsSource="{Binding PresetDetails}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresetDetail">
                      <Border Classes="card" Margin="0,0,0,6" Padding="10">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding RunName}" FontWeight="SemiBold" FontSize="12"
                                     TextTrimming="CharacterEllipsis" />

                          <!-- The preset still stores an effect and a color for a segment it turns
                               off. Showing them here read as a promise the house would not keep. -->
                          <TextBlock Classes="hint" FontStyle="Italic"
                                     Text="off in this preset"
                                     IsVisible="{Binding IsOff}" />

                          <StackPanel Orientation="Horizontal" Spacing="6"
                                      IsVisible="{Binding !IsOff}">
                            <Border Width="18" Height="18" CornerRadius="3"
                                    Background="{Binding PrimarySwatch}"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" />
                            <Border Width="18" Height="18" CornerRadius="3"
                                    Background="{Binding SecondarySwatch}"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                    IsVisible="{Binding HasSecondary}" />
                            <TextBlock Classes="hint" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                              <Run Text="effect " /><Run Text="{Binding Effect}" FontWeight="SemiBold" />
                            </TextBlock>
                          </StackPanel>

                          <TextBlock Classes="hint" IsVisible="{Binding !IsOff}">
                            <Run Text="palette " /><Run Text="{Binding Palette}" /><Run Text="  ·  " /><Run Text="{Binding Motion}" />
                          </TextBlock>

                          <TextBlock Classes="hint" FontStyle="Italic" Opacity="0.55"
                                     IsVisible="{Binding !IsOff}"
                                     Text="{Binding Fidelity}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="Effects LedBalloon knows are run properly, at the frame rate the controller is set to. The rest are stood in for by sliding the segment's palette along it, which gets the colors right and the movement only roughly." />

                <!-- Checking the presets is a preset job, so it lives with the presets. It spent a
                     while under a "Health" heading over in Setup, next to the layout, which is a
                     different question about different things. -->
                <Button Classes="block" Content="Check the presets" Margin="0,10,0,0"
                        Command="{Binding AuditCommand}" />
                <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="A preset saved when you thought a run was shorter puts that old length back when it is recalled, so the LEDs you found later stay dark. This reads every preset on every controller and lists the ones that would." />

                <ItemsControl ItemsSource="{Binding PresetGaps}" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Classes="hint" Margin="0,2" TextWrapping="Wrap"
                                 Foreground="#C9821B" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Tuning one run by hand is the less common job, so it folds away. -->
              <!-- A swatch that opens the picker, rather than a picker that is always open:
                   most of the time the preset list is what is wanted and the wheel is just bulk. -->
              <TextBlock Classes="heading" Text="By hand" Margin="0,14,0,0" />

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Padding="6,4" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="22" Height="22" CornerRadius="4"
                            Background="{Binding PickedBrush}"
                            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" />
                    <TextBlock Text="Color" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button.Flyout>
                    <Flyout Placement="Bottom">
                      <ColorView Color="{Binding PickedColor, Mode=TwoWay}"
                                 IsAlphaEnabled="False"
                                 IsColorPaletteVisible="True"
                                 IsColorComponentsVisible="False" />
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>

              <StackPanel Spacing="4"
                          IsVisible="{Binding SelectedSegment, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <TextBlock Classes="hint" Margin="0,8,0,2" Text="Effect" />
                <ComboBox ItemsSource="{Binding SegmentEffects}"
                          SelectedItem="{Binding SegmentEffectChoice}"
                          PlaceholderText="Not reported yet"
                          HorizontalAlignment="Stretch" />

                <TextBlock Classes="hint" Margin="0,8,0,2" Text="Palette" />
                <ComboBox ItemsSource="{Binding SegmentPalettes}"
                          SelectedItem="{Binding SegmentPaletteChoice}"
                          PlaceholderText="Not reported yet"
                          HorizontalAlignment="Stretch" />
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </Border>

        <ctrl:HouseCanvas Project="{Binding Project}"
                          Photo="{Binding PhotoBytes, Converter={x:Static vm:Converters.PhotoBitmap}}"
                          LayoutRevision="{Binding LayoutRevision}"
                          SelectedSegment="{Binding SelectedSegment}"
                          ControllerStates="{Binding DisplayStates}"
                          Palettes="{Binding Palettes}"
                          EffectNames="{Binding EffectNames}"
                          FrameTimes="{Binding FrameTimes}"
                          IsDrawing="False"
                          SegmentPicked="OnSegmentPicked" />
      </DockPanel>

      <!-- ================= SETUP: describe the house ================= -->
      <DockPanel IsVisible="{Binding IsSetupMode}">

        <Border DockPanel.Dock="Top" Padding="14,10"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
          <DockPanel>
            <!-- Saving is a document-level action, so it belongs up here where it is always in
                 reach, not at the end of a long scroll. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
              <Button Content="Revert"
                      ToolTip.Tip="Read the layout back off the controllers, throwing away unsaved changes"
                      Command="{Binding RevertCommand}"
                      IsVisible="{Binding HasUnsavedChanges}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="Save to controllers"
                      Command="{Binding SaveProjectCommand}" IsEnabled="{Binding !IsBusy}" />
              <Button Content="Overwrite anyway"
                      Command="{Binding OverwriteNewerRevisionCommand}"
                      IsVisible="{Binding SaveBlockedByNewerRevision}" />
              <Button Content="Done — back to colors"
                      Command="{Binding FinishSetupCommand}"
                      IsEnabled="{Binding HasSegments}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
              <!-- The badge belongs beside the title, not in the button strip. Sitting among
                   buttons, at button height, it read as a button you could press. Here it is
                   plainly a label on the thing it describes. -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Setting up the house" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Padding="6,1" CornerRadius="3" VerticalAlignment="Center"
                        Background="#33C9821B" BorderBrush="#C9821B" BorderThickness="1"
                        IsVisible="{Binding HasUnsavedChanges}">
                  <TextBlock Text="Unsaved" FontSize="11" Foreground="#C9821B" />
                </Border>
              </StackPanel>
              <TextBlock Classes="hint"
                         Text="Controllers, segments and where they hang. Saving writes it to every controller and moves their segment boundaries to match." />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border DockPanel.Dock="Left" Width="340" Padding="14"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0">
          <Grid>

            <!-- ============ the house: controllers, each with its segments ============ -->
            <DockPanel IsVisible="{Binding !IsEditingSegment}">

              <!-- Not "The house": that is the name of a tab a few inches to the right, and two
                   different things under one name is worse than a dull name. -->
              <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
                <TextBlock Classes="panelTitle" Text="Controllers" />
              </StackPanel>

              <!-- What is left to warn about, now that overlaps and gaps cannot be expressed. The
                   "Re-lay the whole house" button that used to sit here went with them: the layout
                   is worked out from the lengths every time one changes, so it is always laid. -->
              <Border DockPanel.Dock="Bottom" Classes="card" Background="#33C9821B" Margin="0,10,0,0"
                      IsVisible="{Binding HasLayoutWarnings}">
                <StackPanel Spacing="4">
                  <TextBlock Text="Worth a look" FontWeight="SemiBold" FontSize="12" />
                  <ItemsControl ItemsSource="{Binding LayoutWarnings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Classes="hint" Margin="0,1" Text="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="0">

                <ItemsControl ItemsSource="{Binding Coverage}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ControllerCoverage">
                      <Border Classes="card" Margin="0,0,0,8" Padding="8">
                        <StackPanel Spacing="6">

                          <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="icon"
                                    ToolTip.Tip="Change this controller"
                                    Command="{Binding Owner.PickControllerCommand}"
                                    CommandParameter="{Binding}">
                              <TextBlock Text="&#x270E;" />
                              <Button.Flyout>
                                <Flyout Placement="RightEdgeAlignedTop">
                                  <StackPanel Spacing="0" Width="270">

                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Classes="hint" Text="{Binding Summary}" Margin="0,2,0,0" />

                                    <Separator Margin="0,12,0,12" />

                                    <TextBlock Text="Name" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Classes="hint" Margin="0,3,0,6"
                                               Text="Stored in the layout, and written to the controller's own settings so the WLED app agrees. If a settings PIN blocks that, LedBalloon keeps the name anyway and says so." />
                                    <TextBox Text="{Binding Owner.ControllerNameEdit}" PlaceholderText="Front of house" />
                                    <Button Classes="block" Content="Rename" Margin="0,6,0,0"
                                            Command="{Binding Owner.RenameControllerCommand}" />

                                    <Separator Margin="0,14,0,12" />

                                    <TextBlock Text="Work out its segments" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Classes="hint" Margin="0,3,0,6"
                                               Text="From the wiring: asks the controller how its outputs are wired and makes a segment for each. From the presets: every preset stores its own copy of the segment bounds, so this weighs them against each other and asks about any disagreement. Both replace the segments already here, including the lines traced on the photo." />
                                    <Button Classes="block" Content="From its wiring"
                                            Command="{Binding Owner.ImportFromControllerCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="block" Content="From its presets" Margin="0,6,0,0"
                                            Command="{Binding Owner.ProposeLayoutCommand}" />

                                  </StackPanel>
                                </Flyout>
                              </Button.Flyout>
                            </Button>

                            <StackPanel Spacing="2" Margin="2,0,0,0" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding IsConnected, Converter={x:Static vm:Converters.ConnectionBrush}}" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Classes="hint" VerticalAlignment="Center"
                                           Text="{Binding Host}" />
                              </StackPanel>
                              <TextBlock Classes="hint" Text="{Binding Summary}" />
                            </StackPanel>
                          </DockPanel>

                          <Border Margin="6,0,0,0" Padding="10,2,0,2"
                                  BorderBrush="{DynamicResource PanelBorder}" BorderThickness="2,0,0,0">
                            <StackPanel Spacing="2">

                              <ItemsControl ItemsSource="{Binding Runs}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:SegmentRow">
                                    <DockPanel Margin="0,2">

                                      <Button DockPanel.Dock="Right" Classes="icon"
                                              ToolTip.Tip="Remove this segment"
                                              Command="{Binding Owner.DeleteSegmentCommand}"
                                              CommandParameter="{Binding}">
                                        <TextBlock Text="&#x1F5D1;" />
                                      </Button>

                                      <Button DockPanel.Dock="Right" Classes="icon"
                                              ToolTip.Tip="Change this segment"
                                              Command="{Binding Owner.EditSegmentCommand}"
                                              CommandParameter="{Binding}">
                                        <TextBlock Text="&#x270E;" />
                                      </Button>

                                      <Button Classes="row"
                                              Background="{Binding IsSelected, Converter={x:Static vm:Converters.RowHighlight}}"
                                              Command="{Binding Owner.PickSegmentRowCommand}"
                                              CommandParameter="{Binding}">
                                        <StackPanel Spacing="1">
                                          <TextBlock Text="{Binding Segment.Name}" FontWeight="SemiBold"
                                                     TextTrimming="CharacterEllipsis" />
                                          <TextBlock Classes="hint" Text="{Binding Placement}" />
                                          <TextBlock Classes="hint" Foreground="#C9821B" FontSize="11"
                                                     IsVisible="{Binding !Segment.HasGeometry}"
                                                     Text="not traced on the photo yet" />
                                        </StackPanel>
                                      </Button>
                                    </DockPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>

                              <TextBlock Classes="hint" Margin="0,4"
                                         IsVisible="{Binding !HasRuns}"
                                         Text="Nothing described on this controller yet. Add a segment below, or use the pencil to read its wiring." />
                            </StackPanel>
                          </Border>

                          <!-- On the card rather than only in the pencil menu: adding a segment is
                               the ordinary thing you do here, and it says which controller it
                               lands on by sitting under that controller's own list. -->
                          <Button Classes="block" FontSize="12" Padding="6,3"
                                  Content="+  Add a segment"
                                  Command="{Binding Owner.AddSegmentCommand}"
                                  CommandParameter="{Binding}" />

                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ======== finding controllers, and what is wrong with them ========
                     These were a "Controllers" tab beside the photo. Splitting the house across
                     two places meant the cards on the left listed controllers you could not act
                     on, and the tab acted on a controller the cards did not show you had picked.
                     Everything about a controller now hangs off that controller's own card. -->
                <Separator Margin="0,6,0,10" />

                <TextBlock Classes="heading" Text="Find more" />
                <TextBlock Classes="hint" Margin="0,3,0,8"
                           Text="Found over mDNS and filed by MAC address, so one that comes back on a different IP is still recognized." />

                <Button Classes="block" Content="Scan the network"
                        Command="{Binding ScanCommand}" IsEnabled="{Binding !IsScanning}" />

                <Grid ColumnDefinitions="*,6,Auto" Margin="0,6,0,0">
                  <TextBox Grid.Column="0" PlaceholderText="192.168.0.102" Text="{Binding ManualHost}" />
                  <Button Grid.Column="2" Content="Add" Command="{Binding AddManualCommand}" />
                </Grid>

                <!-- The list of found controllers that used to sit here said the same thing as the
                     cards above it, twice. The cards carry the address instead. The preset check
                     that sat here has gone to the panel where presets are chosen. What is left is
                     the one thing with nowhere else to be: disagreements found while working a
                     controller's segments out from its presets. -->

                <ItemsControl ItemsSource="{Binding LayoutConflicts}" Margin="0,10,0,8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Classes="hint" Margin="0,2" TextWrapping="Wrap"
                                 Foreground="#C9821B" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                </StackPanel>
              </ScrollViewer>
            </DockPanel>

            <!-- ============ one segment, in place of the list ============
                 A templated ContentControl rather than a panel that is merely hidden. Hidden is
                 still built: every control in here went on resolving EditingRow.Segment.Something
                 against a null EditingRow whenever the list was showing, and a Slider's Value
                 cannot be null, so closing the editor filled the log with binding errors. With no
                 content there are no controls and nothing to resolve. -->
            <ContentControl Content="{Binding EditingRow}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:SegmentRow">
                  <DockPanel>

                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                      <Button HorizontalAlignment="Left" Padding="8,3"
                              Command="{Binding Owner.CloseSegmentEditorCommand}">
                        <TextBlock Text="&#x2190;  All controllers" />
                      </Button>
                      <TextBlock Classes="panelTitle" TextTrimming="CharacterEllipsis"
                                 Text="{Binding Segment.Name}" />
                      <TextBlock Classes="hint" Text="{Binding ControllerName, StringFormat='On {0}'}" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="6" Margin="0,0,6,0">

                        <TextBlock Classes="hint" Text="Name" />
                        <TextBox Text="{Binding Segment.Name}" />

                        <!-- The only number anyone types. Where the run starts is worked out from
                             which output it is on and what is ahead of it, so there is no "starts
                             at" box any more and no way to type an overlap. -->
                        <TextBlock Classes="hint" Text="LEDs" />
                        <TextBox Text="{Binding Segment.Count}" />

                        <TextBlock Classes="heading" Text="Where it is plugged in" Margin="0,10,0,4" />

                        <ComboBox ItemsSource="{Binding Owner.OutputChoices}"
                                  SelectedItem="{Binding Owner.OutputChoice}"
                                  PlaceholderText="Which output"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Classes="hint" Margin="0,2,0,0" Text="Order on that output" />
                        <Grid ColumnDefinitions="*,6,*">
                          <Button Grid.Column="0" Classes="block" FontSize="12" Padding="6,3"
                                  Content="Move earlier"
                                  Command="{Binding Owner.MoveSegmentEarlierCommand}" />
                          <Button Grid.Column="2" Classes="block" FontSize="12" Padding="6,3"
                                  Content="Move later"
                                  Command="{Binding Owner.MoveSegmentLaterCommand}" />
                        </Grid>

                        <TextBlock Classes="hint" Margin="0,4,0,0" Text="{Binding Placement}" />

                        <TextBlock Classes="heading" Text="On the photo" Margin="0,10,0,4" />

                        <!-- Here rather than over the photo: tracing needs the photo visible and
                             the segment already picked, and both are true whenever this is open. -->
                        <Button Classes="block" Content="Trace it on the photo"
                                Command="{Binding Owner.StartDrawingSegmentCommand}"
                                IsEnabled="{Binding !Owner.IsDrawingSegment}" />
                        <Button Classes="block" Content="Done tracing"
                                Command="{Binding Owner.FinishDrawingSegmentCommand}"
                                IsEnabled="{Binding Owner.IsDrawingSegment}" />
                        <Button Classes="block" Content="Flip which end is LED 1"
                                Command="{Binding Owner.FlipSegmentDirectionCommand}" />

                        <TextBlock Classes="hint" Foreground="#C9821B"
                                   IsVisible="{Binding !Segment.HasGeometry}"
                                   Text="No line on the photo yet, so it cannot be shown or clicked there." />

                        <TextBlock Classes="heading" Text="What kind of light" Margin="0,10,0,4" />

                        <ComboBox ItemsSource="{Binding Owner.FixtureStyles}"
                                  SelectedItem="{Binding Owner.FixtureChoice}"
                                  PlaceholderText="Pick a fixture"
                                  HorizontalAlignment="Stretch" />

                        <!-- "Aim the other way" used to live here. It was a second way of saying
                             "uplight": a downlight and an uplight aim at exactly opposite
                             perpendiculars and draw identically otherwise, so ticking it on one
                             always landed on the other. Picking the fixture says it once. -->
                        <StackPanel Spacing="4" IsVisible="{Binding Segment.Fixture.IsAimed}">
                          <TextBlock Classes="hint" Margin="0,6,0,0" Text="Beam spread" />
                          <Slider Minimum="10" Maximum="160"
                                  Value="{Binding Segment.Fixture.BeamAngleDegrees}" />
                          <TextBlock Classes="hint" Text="How far it reaches" />
                          <Slider Minimum="0.02" Maximum="0.6"
                                  Value="{Binding Segment.Fixture.ThrowLength}" />
                        </StackPanel>

                      </StackPanel>
                    </ScrollViewer>
                  </DockPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

          </Grid>
        </Border>

        <TabControl Margin="14,8,14,8">

          <TabItem Header="The house">
            <DockPanel>
              <!-- Tracing moved into the segment's own editor on the left, where the segment
                   being traced is named and the photo is not covered by anything. -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="4,8">
                <Button Content="Load photo" Click="OnLoadPhoto" />
                <Border Padding="8,3" CornerRadius="3" Background="#2F7BD6" VerticalAlignment="Center"
                        IsVisible="{Binding IsDrawingSegment}">
                  <TextBlock Text="Tracing" FontSize="12" Foreground="White" />
                </Border>
              </StackPanel>

              <!-- Says what a click does now, which is not the same in both modes. -->
              <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="4,0,4,8"
                         Text="{Binding PhotoHint}" />

              <ctrl:HouseCanvas Project="{Binding Project}"
                                Photo="{Binding PhotoBytes, Converter={x:Static vm:Converters.PhotoBitmap}}"
                                LayoutRevision="{Binding LayoutRevision}"
                                SelectedSegment="{Binding SelectedSegment}"
                                ControllerStates="{Binding ControllerStates}"
                                IsDrawing="{Binding IsDrawingSegment}"
                                PointAdded="OnCanvasPointAdded"
                                SegmentPicked="OnSegmentPicked" />
            </DockPanel>
          </TabItem>

          <TabItem Header="Schedule">
            <DockPanel Margin="8,8,8,8">

              <StackPanel DockPanel.Dock="Top" Spacing="6">
                <!-- Same as Setup: the badge sits on the heading, clear of the buttons. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Timers" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Padding="6,1" CornerRadius="3" VerticalAlignment="Center"
                          Background="#33C9821B" BorderBrush="#C9821B" BorderThickness="1"
                          IsVisible="{Binding ScheduleChanged}">
                    <TextBlock Text="Unsaved" FontSize="11" Foreground="#C9821B" />
                  </Border>
                </StackPanel>
                <TextBlock Classes="hint"
                           Text="The controllers run this by themselves, with or without this app open. It is stored on them like everything else, so it survives reinstalling and it keeps going when the computer is off." />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,6">
                  <Button Content="Add a timer" Command="{Binding AddScheduleEntryCommand}" />
                  <Button Content="Save to controllers"
                          Command="{Binding SaveScheduleCommand}"
                          IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
              </StackPanel>

              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Schedule}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduleRow">
                      <Border Classes="card" Margin="0,0,0,6" Padding="10">
                        <StackPanel Spacing="6">

                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{Binding Enabled}" Content="On" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ControllerName}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Content="Remove" Padding="6,2"
                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveScheduleEntryCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>

                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <ComboBox ItemsSource="{Binding Triggers}"
                                      SelectedItem="{Binding Trigger}" Width="120" />
                            <NumericUpDown Value="{Binding Hour}" Minimum="0" Maximum="23"
                                           FormatString="00" ShowButtonSpinner="False" Width="52"
                                           IsVisible="{Binding IsClock}" />
                            <TextBlock Text=":" VerticalAlignment="Center"
                                       IsVisible="{Binding IsClock}" />
                            <NumericUpDown Value="{Binding Minute}" Minimum="0" Maximum="59"
                                           FormatString="00" ShowButtonSpinner="False" Width="52"
                                           IsVisible="{Binding IsClock}" />
                            <TextBlock Text="show" VerticalAlignment="Center" Classes="hint" />
                            <ComboBox ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding Preset}"
                                      PlaceholderText="pick a preset" MinWidth="200" />
                          </StackPanel>

                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </TabItem>


        </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
