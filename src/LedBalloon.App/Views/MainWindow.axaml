<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:vm="using:LedBalloon.App.ViewModels"
        xmlns:ctrl="using:LedBalloon.App.Controls"
        xmlns:layout="using:LedBalloon.Core.Layout"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="LedBalloon.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="LedBalloon"
        Width="1280" Height="820"
        MinWidth="1040" MinHeight="620">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelBackground" Color="#F4F5F7" />
          <SolidColorBrush x:Key="PanelBorder" Color="#DFE1E5" />
          <SolidColorBrush x:Key="StatusBackground" Color="#E9EBEF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PanelBackground" Color="#16181C" />
          <SolidColorBrush x:Key="PanelBorder" Color="#2A2E35" />
          <SolidColorBrush x:Key="StatusBackground" Color="#1A1D22" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.panelTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.block">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- A run in the list marks itself as picked and does nothing else. It used to flash the
         theme's pressed shading, which read as a button that had done something and then thought
         better of it - when all it does is decide what the photo highlights and what Draw
         selected segment will trace. The pencil beside it is the thing that acts. -->
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <Style Selector="Button.row">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.row /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Status bar. The hardware lives down here once it is working. -->
    <Border DockPanel.Dock="Bottom" Padding="12,7"
            Background="{DynamicResource StatusBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="hint" Margin="12,0,0,0"
                   Text="{Binding ControllerSummary}" />
        <Border DockPanel.Dock="Right" Margin="12,0,0,0" Padding="7,1" CornerRadius="3"
                Background="#C9821B" IsVisible="{Binding HasUnsavedChanges}">
          <TextBlock Text="Unsaved changes" FontSize="12" Foreground="White" />
        </Border>
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>

      <!-- ================= STARTING: finding the controllers ================= -->
      <Border IsVisible="{Binding IsStartingMode}" Background="{DynamicResource PanelBackground}">
        <Border Classes="card" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="0" ClipToBounds="True" Background="{DynamicResource StatusBackground}">
          <StackPanel Spacing="0">

            <!-- The L-7 WLED, moored and strung with lights. Waiting for a controller to answer is
                 dead time; give it something to look at rather than a spinner on a blank card. -->
            <Image Source="avares://LedBalloon.App/Assets/airship.jpg"
                   Stretch="UniformToFill" Height="240" />

            <StackPanel Spacing="14" Margin="26">

            <TextBlock Text="LedBalloon" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Classes="hint"
                       Text="Your controllers hold the layout, so there is nothing to open — it just has to be found. This takes a few seconds." />

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4"
                         IsVisible="{Binding IsScanning}" />

            <ItemsControl ItemsSource="{Binding StartupSteps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Classes="hint" Margin="0,2" TextWrapping="Wrap" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Nothing answered: explain why that happens and offer both ways on. -->
            <StackPanel Spacing="10" IsVisible="{Binding StartupFoundNothing}">
              <TextBlock Classes="hint"
                         Text="Discovery uses mDNS, which does not cross subnets or most VPNs. If your controllers are on another part of the network, add one by address instead." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Look again" Command="{Binding ScanCommand}"
                        IsEnabled="{Binding !IsScanning}" />
                <TextBox Width="150" PlaceholderText="192.0.2.11" Text="{Binding ManualHost}" />
                <Button Content="Add by address" Command="{Binding AddManualCommand}" />
              </StackPanel>
              <Button Content="Continue without a controller"
                      Command="{Binding ContinueWithoutControllersCommand}"
                      HorizontalAlignment="Left" />
            </StackPanel>

            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <!-- ================= DESIGN: what color should things be ================= -->
      <DockPanel IsVisible="{Binding IsDesignMode}">

        <Border DockPanel.Dock="Top" Padding="14,10"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Setup" Command="{Binding GoToSetupCommand}" />

            <!-- Every word on this screen is a term of art and none of them was ever defined, which
                 is how the app came to call one thing a segment in one place and a run in another. -->
            <Button DockPanel.Dock="Right" Content="Help" Margin="0,0,8,0"
                    Command="{Binding ShowGlossaryCommand}" />

            <!-- The control is the sentence. A box labelled "Sync" says what the setting is
                 called and nothing about what it does, and the two things it decides between are
                 worth a sentence each; a switch that carries them costs one click to read and one
                 click to change. Left-aligned content and a minimum width so the row does not jump
                 as the wording changes under it. -->
            <ToggleSwitch DockPanel.Dock="Right" Margin="12,0"
                          IsChecked="{Binding LiveSync}" VerticalAlignment="Center"
                          MinWidth="330" HorizontalContentAlignment="Left"
                          OffContent="Editing in the app only"
                          OnContent="{Binding SyncOnLabel}" />

            <!-- Which lights, said out loud. It was "On"/"Off" beside nothing, and a switch with no
                 subject is a switch you have to press to find out about. No brightness beside it:
                 that belongs to a controller, and each has its own slider at the head of its
                 segments - a house-wide one could only set them all to the same number, which is to
                 say it could only destroy the difference between them. -->
            <ToggleSwitch IsChecked="{Binding MasterOn}"
                          OnContent="The house lights are on"
                          OffContent="The house lights are off"
                          MinWidth="210" HorizontalContentAlignment="Left"
                          VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <!-- One banner for one fact: the app is showing something the house is not. It used to be
             two - a preview strip for an unapplied scene and a pair of buttons in the top bar for
             held edits - which are the same thing to whoever is reading them. Tick Sync and both
             go. The photo carries it because the photo is the thing that looks like the truth. -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#2F7BD6"
                IsVisible="{Binding AppOnly}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Discard"
                    Command="{Binding DiscardPendingCommand}"
                    IsVisible="{Binding HasPendingChanges}" />
            <TextBlock Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,12,0">
              <Run Text="{Binding AppOnlyNotice}" /><Run Text="  Tick Sync to put it there." />
            </TextBlock>
          </DockPanel>
        </Border>

        <!-- Color and presets. Wider than the setup sidebar, because a preset needs describing
             and the photo only has to be big enough to read. -->
        <Border DockPanel.Dock="Right" Width="420" Padding="14"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">

              <!-- This screen is a scene editor, so the scene being edited is the first thing on it
                   and the picker is the heading. There is always one: whatever the house is showing,
                   named if it has been written down and not if it has not.
                   The picker rather than a title above it, because a title would be the name a
                   second time, and the picker is the one of the two that can also change it. -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="panelTitle" Text="Scene:" VerticalAlignment="Center" />
                <!-- Italic for the house, upright for a scene. The first row of this list is not
                     a name somebody chose, it is a description of the thing that has no name yet,
                     and sitting in the same column as the named ones it read like one of them. -->
                <ComboBox ItemsSource="{Binding Scenes}"
                 AutomationProperties.AutomationId="SceneList"
                          SelectedItem="{Binding SelectedScene}"
                          PlaceholderText="The house as it is now"
                          HorizontalAlignment="Stretch" Width="300">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SceneRow">
                      <TextBlock Text="{Binding Name}" FontStyle="{Binding NameStyle}"
                                 TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding SceneState}" />

              <!-- The house changes on its own, so say so here rather than letting it look like
                   the app lost track of what it set. -->
              <Border Classes="card" Padding="8" Margin="0,4,0,0"
                      IsVisible="{Binding ScheduleNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="hint" Text="{Binding ScheduleNotice}" />
              </Border>

              <!-- Naming is the only way work leaves this screen, so it is the first thing on it
                   when there is anything to name, and absent when there is not. -->
              <Button Classes="block" Content="Name it…" Margin="0,4,0,0"
                      Command="{Binding CaptureSceneCommand}"
                      IsVisible="{Binding SceneUnsaved}" />

              <!-- No banner and no buttons for sending: whether this has reached the lights is what
                   the Sync switch says, in one place, for everything on this panel. -->
              <!-- Everything a saved scene can have done to it. The house is in that list too now,
                   and none of this applies to it. -->
              <StackPanel Spacing="8" IsVisible="{Binding SceneIsSaved}">

                <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding SceneOrigin}"
                           IsVisible="{Binding SceneOrigin, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- What the layout cannot account for, said before the adopt button rather than
                     only when it is pressed. -->
                <ItemsControl ItemsSource="{Binding SceneNotes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Classes="hint" Margin="0,2" TextWrapping="Wrap"
                                 Foreground="#C9821B" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Changing a run while a scene is picked changes that scene. This is the way to
                     start from one and branch instead, and it puts the original back. -->
                <StackPanel Spacing="4" IsVisible="{Binding SceneEdited}">
                  <TextBlock Classes="hint" TextWrapping="Wrap" Foreground="#C9821B"
                             Text="Changed by hand. Saving writes this over the scene." />
                  <Button Classes="block" Content="Keep this as a new scene instead"
                          Command="{Binding SaveSceneAsNewCommand}" />
                </StackPanel>

                <!-- No "Put it on the house" here. Opening a scene always previews it, so the
                     strip over the photo always carries that button, and two of them a few
                     centimetres apart is two chances to wonder whether they do the same thing. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Rename" Command="{Binding RenameSceneCommand}"
                          IsVisible="{Binding SceneIsOwn}" />
                  <Button Content="Remove" Command="{Binding DeleteSceneCommand}"
                          IsVisible="{Binding SceneIsOwn}" />
                </StackPanel>

              </StackPanel>

              <!-- ===== What the scene is doing, segment by segment. These used to appear only
                   for a saved scene, which left the main screen with nothing to show for the house
                   in front of you - and then used to disappear while one segment was being edited,
                   because the editor took the panel over. The editor is a window now, so this is
                   simply the panel. ===== -->
              <StackPanel Spacing="8">

              <!-- What the scene actually does, which its name does not tell you. -->
              <ItemsControl ItemsSource="{Binding SceneDetails}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ControllerSegments">
                   <!-- Drawn as a box so that which segments belong to which controller is a thing
                        you see rather than a thing you work out from the order. It matters more now
                        that the brightness inside it applies to everything in it and nothing
                        outside it. -->
                   <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                           CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                   <StackPanel>

                    <!-- The controller heading carries its own brightness, because that is what
                         brightness belongs to: a scene is one preset per controller and each one
                         has its own. Above the segments it governs, so there is nothing to say. -->
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,2" />

                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Classes="hint" DockPanel.Dock="Left" Text="brightness"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                      <!-- As a proportion. "38" beside a slider says nothing about how dark that
                           is; 15% says why the photo looks the way it does. -->
                      <TextBlock Classes="hint" DockPanel.Dock="Right" Width="36"
                                 TextAlignment="Right" VerticalAlignment="Center"
                                 Margin="6,0,10,0"
                                 Text="{Binding Percent}" />
                      <!-- Disabled rather than explained when the scene does not set it. A
                           control that cannot do anything should look like one; a sentence saying
                           so is a second thing to read to learn what the grey already says. -->
                      <Slider Minimum="0" Maximum="255"
                       AutomationProperties.AutomationId="ControllerBrightness"
                              IsEnabled="{Binding SetByTheScene}"
                              Value="{Binding Brightness, Mode=TwoWay}" />
                    </DockPanel>

                    <!-- The one promise on this screen the hardware cannot keep. Nothing fixes it,
                         so it is said rather than hidden. -->
                    <TextBlock Classes="hint" TextWrapping="Wrap" Foreground="#C9821B"
                               Margin="0,-2,0,6"
                               Text="{Binding BrightnessReaches}"
                               IsVisible="{Binding HasBrightnessWarning}" />

                    <ItemsControl ItemsSource="{Binding Segments}">
                     <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SceneSegmentRow">
                    <!-- No box. The controller already draws one round its own segments, and a box
                         inside a box for every segment turned the panel into a stack of frames with
                         two lines in each. What separates one segment from the next is its name and
                         the space above it. -->
                    <StackPanel Margin="0,0,0,10">
                      <StackPanel Spacing="4">

                        <DockPanel>
                          <!-- The pencil is the thing that edits, rather than the name being
                               secretly a button. Finding the right few pixels of a traced line on
                               the photograph is the other way to ask and a poor one - Porch is five
                               LEDs - so this is the reliable one. -->
                          <Button Classes="icon" DockPanel.Dock="Right"
                           AutomationProperties.AutomationId="EditSegment"
                                  Command="{Binding EditCommand}"
                                  ToolTip.Tip="Change what this segment is showing"
                                  VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="&#x270E;" />
                          </Button>

                          <TextBlock Text="{Binding Detail.SegmentName}" FontWeight="SemiBold"
                                     FontSize="12" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <!-- The three things a scene can do about a segment, in one control, because
                             they are one decision. Off and "not included" look the same on a dark
                             house and are opposites the rest of the time, so which of them applies
                             has to be picked rather than inferred from whether anyone got round to
                             mentioning the segment. Absent while looking at the house, which is not
                             a scene and so has nothing to decide. -->
                        <!-- Each row draws what it would put on the segment - its colors, its
                             effect and how it moves - because that is the question being asked.
                             A list of names answers it only for somebody who remembers what each
                             name means, which is why the description used to be repeated
                             underneath, where it described the selected row and none of the
                             others. No palette: WLED names them, nothing here lets anybody make
                             one or name one, so "Custom 0" is a slot number from the firmware. -->
                        <ComboBox ItemsSource="{Binding Choices}"
                         AutomationProperties.AutomationId="SegmentRole"
                                  SelectedItem="{Binding Choice, Mode=TwoWay}"
                                  IsVisible="{Binding Choosable}"
                                  HorizontalAlignment="Stretch" Margin="0,2,0,0">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SegmentChoice">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- The palette the effect draws from, sampled the way the photo
                                     samples it. Most effects take their color from here and ignore
                                     the slots, so without it most rows carried no color at all. -->
                                <Border Width="34" Height="14" CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Background="{Binding Gradient}"
                                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                        IsVisible="{Binding HasGradient}" />
                                <Border Width="14" Height="14" CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Background="{Binding Primary}"
                                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                        IsVisible="{Binding HasAppearance}" />
                                <Border Width="14" Height="14" CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Background="{Binding Secondary}"
                                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                        IsVisible="{Binding HasSecondary}" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding HasName}" />
                                <TextBlock Text="{Binding Description}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- The house gets no picker, being not a scene, so its cards would have
                             been a column of bare names. What the picker says in a scene, this
                             says there - in the same shape, so the two read as one thing. -->
                        <StackPanel Spacing="4" IsVisible="{Binding !Choosable}">

                          <!-- Why there is nothing to show, when there is nothing. The list is the
                               house rather than the part of it the controllers happen to be cut
                               for, so a segment with no segment on the box is still a row. -->
                          <TextBlock Classes="hint" FontStyle="Italic"
                                     TextWrapping="Wrap"
                                     Text="{Binding Detail.Aside}"
                                     IsVisible="{Binding Detail.HasAside}" />

                          <TextBlock Classes="hint" FontStyle="Italic" Text="off"
                                     IsVisible="{Binding Detail.IsOff}" />

                          <StackPanel Orientation="Horizontal" Spacing="6"
                                      IsVisible="{Binding Detail.Describes}">
                            <Border Width="14" Height="14" CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Background="{Binding Detail.PrimarySwatch}"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                    IsVisible="{Binding Detail.HasPrimary}" />
                            <Border Width="14" Height="14" CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Background="{Binding Detail.SecondarySwatch}"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                    IsVisible="{Binding Detail.HasSecondary}" />
                            <TextBlock Classes="hint" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding Detail.Effect}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Detail.Motion}" />
                            </TextBlock>
                          </StackPanel>
                        </StackPanel>

                        <!-- All that is left to say. The row above has the rest of it. -->
                        <TextBlock Classes="hint" FontStyle="Italic" Opacity="0.55"
                                   Text="{Binding Detail.Fidelity}"
                                   IsVisible="{Binding Detail.Fidelity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </StackPanel>
                      </DataTemplate>
                     </ItemsControl.ItemTemplate>
                    </ItemsControl>
                   </StackPanel>
                   </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>


              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </Border>

        <ctrl:HouseCanvas Project="{Binding Project}"
                          Photo="{Binding PhotoBytes, Converter={x:Static vm:Converters.PhotoBitmap}}"
                          LayoutRevision="{Binding LayoutRevision}"
                          SelectedSegment="{Binding SelectedSegment}"
                          ControllerStates="{Binding DisplayStates}"
                          Palettes="{Binding Palettes}"
                          EffectNames="{Binding EffectNames}"
                          FrameTimes="{Binding FrameTimes}"
                          IsDrawing="False"
                          SegmentPicked="OnSegmentPicked" />
      </DockPanel>

      <!-- ================= SETUP: describe the house ================= -->
      <DockPanel IsVisible="{Binding IsSetupMode}">

        <Border DockPanel.Dock="Top" Padding="14,10"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
          <DockPanel>
            <!-- Saving is a document-level action, so it belongs up here where it is always in
                 reach, not at the end of a long scroll. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
              <Button Content="Revert"
                      ToolTip.Tip="Read the layout back off the controllers, throwing away unsaved changes"
                      Command="{Binding RevertCommand}"
                      IsVisible="{Binding HasUnsavedChanges}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="Save to controllers"
                      Command="{Binding SaveProjectCommand}" IsEnabled="{Binding !IsBusy}" />
              <Button Content="Overwrite anyway"
                      Command="{Binding OverwriteNewerRevisionCommand}"
                      IsVisible="{Binding SaveBlockedByNewerRevision}" />
              <Button Content="Done — back to colors"
                      Command="{Binding FinishSetupCommand}"
                      IsEnabled="{Binding HasSegments}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
              <!-- The badge belongs beside the title, not in the button strip. Sitting among
                   buttons, at button height, it read as a button you could press. Here it is
                   plainly a label on the thing it describes. -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Setting up the house" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Padding="6,1" CornerRadius="3" VerticalAlignment="Center"
                        Background="#33C9821B" BorderBrush="#C9821B" BorderThickness="1"
                        IsVisible="{Binding HasUnsavedChanges}">
                  <TextBlock Text="Unsaved" FontSize="11" Foreground="#C9821B" />
                </Border>
              </StackPanel>
              <TextBlock Classes="hint"
                         Text="Controllers, segments and where they hang. Saving writes it to every controller and moves their segment boundaries to match." />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border DockPanel.Dock="Left" Width="340" Padding="14"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0">
          <Grid>

            <!-- ============ the house: controllers, each with its segments ============ -->
            <DockPanel IsVisible="{Binding IsShowingControllers}">

              <!-- Not "The house": that is the name of a tab a few inches to the right, and two
                   different things under one name is worse than a dull name. -->
              <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
                <TextBlock Classes="panelTitle" Text="Controllers" />
              </StackPanel>

              <!-- What is left to warn about, now that overlaps and gaps cannot be expressed. The
                   "Re-lay the whole house" button that used to sit here went with them: the layout
                   is worked out from the lengths every time one changes, so it is always laid. -->
              <Border DockPanel.Dock="Bottom" Classes="card" Background="#33C9821B" Margin="0,10,0,0"
                      IsVisible="{Binding HasLayoutWarnings}">
                <StackPanel Spacing="4">
                  <TextBlock Text="Worth a look" FontWeight="SemiBold" FontSize="12" />
                  <ItemsControl ItemsSource="{Binding LayoutWarnings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Classes="hint" Margin="0,1" Text="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="0">

                <ItemsControl ItemsSource="{Binding Coverage}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ControllerCoverage">
                      <Border Classes="card" Margin="0,0,0,8" Padding="8">
                        <StackPanel Spacing="6">

                          <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="icon"
                                    ToolTip.Tip="Change this controller"
                                    Command="{Binding Owner.PickControllerCommand}"
                                    CommandParameter="{Binding}">
                              <TextBlock Text="&#x270E;" />
                              <Button.Flyout>
                                <Flyout Placement="RightEdgeAlignedTop">
                                  <StackPanel Spacing="0" Width="270">

                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Classes="hint" Text="{Binding Summary}" Margin="0,2,0,0" />

                                    <Separator Margin="0,12,0,12" />

                                    <TextBlock Text="Name" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Classes="hint" Margin="0,3,0,6"
                                               Text="Stored in the layout, and written to the controller's own settings so the WLED app agrees. If a settings PIN blocks that, LedBalloon keeps the name anyway and says so." />
                                    <TextBox Text="{Binding Owner.ControllerNameEdit}" PlaceholderText="Front of house" />
                                    <Button Classes="block" Content="Rename" Margin="0,6,0,0"
                                            Command="{Binding Owner.RenameControllerCommand}" />

                                    <Separator Margin="0,14,0,12" />

                                    <!-- Asked rather than detected, because it cannot be detected:
                                         a microphone in a quiet street and no microphone at all
                                         both report quiet. Ticking it is what decides whether two
                                         dozen sound-driven effects are worth offering here. -->
                                    <TextBlock Text="Sound" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Classes="hint" Margin="0,3,0,6"
                                               Text="Some effects follow music. They need a microphone wired to the controller, or another WLED device on the network sharing what it hears. Without one they leave the lights exactly as they were, so they are left out of the list." />
                                    <CheckBox Content="This controller can hear sound"
                                              AutomationProperties.AutomationId="ControllerHasSound"
                                              IsChecked="{Binding Owner.ControllerHasSound}" />
                                    <TextBlock Classes="hint" Margin="0,3,0,0"
                                               Text="{Binding Owner.ControllerSoundNote}"
                                               IsVisible="{Binding Owner.ControllerSoundNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <Separator Margin="0,14,0,12" />

                                    <TextBlock Text="Work out its segments" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Classes="hint" Margin="0,3,0,6"
                                               Text="From the wiring: asks the controller how its outputs are wired and makes a segment for each. From the presets: every preset stores its own copy of the segment bounds, so this weighs them against each other and asks about any disagreement. Both replace the segments already here, including the lines traced on the photo." />
                                    <Button Classes="block" Content="From its wiring"
                                            Command="{Binding Owner.ImportFromControllerCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="block" Content="From its presets" Margin="0,6,0,0"
                                            Command="{Binding Owner.ProposeLayoutCommand}" />

                                  </StackPanel>
                                </Flyout>
                              </Button.Flyout>
                            </Button>

                            <StackPanel Spacing="2" Margin="2,0,0,0" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding IsConnected, Converter={x:Static vm:Converters.ConnectionBrush}}" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Classes="hint" VerticalAlignment="Center"
                                           Text="{Binding Host}" />
                              </StackPanel>
                              <TextBlock Classes="hint" Text="{Binding Summary}" />

                              <!-- Shown rather than omitted: the layout is kept on every
                                   controller, so an absent one's runs are here and fixable. -->
                              <TextBlock Classes="hint" Foreground="#C9821B" TextWrapping="Wrap"
                                         IsVisible="{Binding IsAbsent}"
                                         Text="{Binding AbsenceNote}" />
                            </StackPanel>
                          </DockPanel>

                          <!-- One block per LED output, because the order within an output is now
                               something you set, and "move earlier" means nothing unless you can
                               see what it is moving inside of. GPIO 16 against GPIO 2 belongs on
                               the output too: it is a fact about the socket, not about the run. -->
                          <ItemsControl ItemsSource="{Binding Outputs}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:OutputGroup">
                                <StackPanel Spacing="2" Margin="0,4,0,0">

                                  <DockPanel Margin="4,0,0,2">
                                    <Button DockPanel.Dock="Right" Classes="icon"
                                            ToolTip.Tip="Add a segment to this output"
                                            Command="{Binding Owner.AddSegmentToOutputCommand}"
                                            CommandParameter="{Binding}">
                                      <TextBlock Text="+" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Classes="icon"
                                            ToolTip.Tip="Colour order and the rest of this output's settings"
                                            IsVisible="{Binding IsReal}"
                                            Command="{Binding Owner.EditOutputCommand}"
                                            CommandParameter="{Binding}">
                                      <TextBlock Text="&#x270E;" />
                                    </Button>

                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold"
                                                 Opacity="0.75" />
                                      <TextBlock Text="{Binding Summary}" Classes="hint" FontSize="11" />
                                    </StackPanel>
                                  </DockPanel>

                                  <!-- The whole block takes a drop, so a run can be dragged onto an
                                       output that has nothing on it yet. -->
                                  <Border Margin="6,0,0,0" Padding="10,2,0,6" MinHeight="24"
                                          Background="Transparent"
                                          BorderBrush="{DynamicResource PanelBorder}" BorderThickness="2,0,0,0"
                                          DragDrop.AllowDrop="True"
                                          DragDrop.DragOver="OnOutputDragOver"
                                          DragDrop.Drop="OnOutputDrop">
                                    <ItemsControl ItemsSource="{Binding Runs}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SegmentRow">
                                          <DockPanel Margin="0,2" Background="Transparent"
                                                     PointerPressed="OnSegmentDragStart">

                                            <Button DockPanel.Dock="Right" Classes="icon"
                                                    ToolTip.Tip="Remove this segment"
                                                    Command="{Binding Owner.DeleteSegmentCommand}"
                                                    CommandParameter="{Binding}">
                                              <TextBlock Text="&#x1F5D1;" />
                                            </Button>

                                            <Button DockPanel.Dock="Right" Classes="icon"
                                                    ToolTip.Tip="Change this segment"
                                                    Command="{Binding Owner.EditSegmentCommand}"
                                                    CommandParameter="{Binding}">
                                              <TextBlock Text="&#x270E;" />
                                            </Button>

                                            <!-- Drag the grip to move it along the output, or onto
                                                 another one. The arrows this replaced could only
                                                 ever shuffle by one. -->
                                            <TextBlock DockPanel.Dock="Left" Text="&#x2630;"
                                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                                       FontSize="11" Opacity="0.4"
                                                       ToolTip.Tip="Drag to reorder, or onto another output" />

                                            <Button Classes="row"
                                                    Background="{Binding IsSelected, Converter={x:Static vm:Converters.RowHighlight}}"
                                                    Command="{Binding Owner.PickSegmentRowCommand}"
                                                    CommandParameter="{Binding}">
                                              <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Segment.Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="hint" Text="{Binding Placement}" />
                                                <TextBlock Classes="hint" Foreground="#C9821B" FontSize="11"
                                                           IsVisible="{Binding !Segment.HasGeometry}"
                                                           Text="not traced on the photo yet" />
                                              </StackPanel>
                                            </Button>
                                          </DockPanel>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </Border>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <TextBlock Classes="hint" Margin="4,4,0,0"
                                     IsVisible="{Binding !HasRuns}"
                                     Text="Nothing described on this controller yet. Add a segment below, or use the pencil to read its wiring." />

                          <!-- The controller-wide "Add a segment" that used to sit here had to
                               guess which output the new run belonged on. Each output has its own
                               + now, so the question does not come up. -->

                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ======== finding controllers, and what is wrong with them ========
                     These were a "Controllers" tab beside the photo. Splitting the house across
                     two places meant the cards on the left listed controllers you could not act
                     on, and the tab acted on a controller the cards did not show you had picked.
                     Everything about a controller now hangs off that controller's own card. -->
                <Separator Margin="0,6,0,10" />

                <TextBlock Classes="heading" Text="Find more" />
                <TextBlock Classes="hint" Margin="0,3,0,8"
                           Text="Found over mDNS and filed by MAC address, so one that comes back on a different IP is still recognized." />

                <Button Classes="block" Content="Scan the network"
                        Command="{Binding ScanCommand}" IsEnabled="{Binding !IsScanning}" />

                <Grid ColumnDefinitions="*,6,Auto" Margin="0,6,0,0">
                  <TextBox Grid.Column="0" PlaceholderText="192.0.2.11" Text="{Binding ManualHost}" />
                  <Button Grid.Column="2" Content="Add" Command="{Binding AddManualCommand}" />
                </Grid>

                <!-- The list of found controllers that used to sit here said the same thing as the
                     cards above it, twice. The cards carry the address instead. The preset check
                     that sat here has gone to the panel where presets are chosen. What is left is
                     the one thing with nowhere else to be: disagreements found while working a
                     controller's segments out from its presets. -->

                <ItemsControl ItemsSource="{Binding LayoutConflicts}" Margin="0,10,0,8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Classes="hint" Margin="0,2" TextWrapping="Wrap"
                                 Foreground="#C9821B" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                </StackPanel>
              </ScrollViewer>
            </DockPanel>

            <!-- ============ one segment, in place of the list ============
                 A templated ContentControl rather than a panel that is merely hidden. Hidden is
                 still built: every control in here went on resolving EditingRow.Segment.Something
                 against a null EditingRow whenever the list was showing, and a Slider's Value
                 cannot be null, so closing the editor filled the log with binding errors. With no
                 content there are no controls and nothing to resolve. -->
            <ContentControl Content="{Binding EditingRow}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:SegmentRow">
                  <DockPanel>

                    <!-- No big title carrying the segment's name: the Name box a few lines down
                         already says it, and says it in the place you can change it. -->
                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                      <Button HorizontalAlignment="Left" Padding="8,3"
                              Command="{Binding Owner.CloseSegmentEditorCommand}">
                        <TextBlock Text="&#x2190;  All controllers" />
                      </Button>
                      <TextBlock Classes="panelTitle" Text="{Binding ControllerName, StringFormat='On {0}'}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="6" Margin="0,0,6,0">

                        <TextBlock Classes="hint" Text="Name" />
                        <TextBox Text="{Binding Segment.Name}" />

                        <!-- The only number anyone types. Where the run starts is worked out from
                             which output it is on and what is ahead of it, so there is no "starts
                             at" box any more and no way to type an overlap. -->
                        <TextBlock Classes="hint" Text="LEDs" />
                        <TextBox Text="{Binding Segment.Count}" />

                        <!-- Nothing here about which output it is on, or where it comes in the
                             order. Both are one thing - where the run sits in the wiring - and
                             both are answered by dragging it there in the list, which is the only
                             place either can be seen. -->


                        <TextBlock Classes="heading" Text="On the photo" Margin="0,10,0,4" />

                        <!-- Here rather than over the photo: tracing needs the photo visible and
                             the segment already picked, and both are true whenever this is open. -->
                        <Button Classes="block" Content="Trace it on the photo"
                                Command="{Binding Owner.StartDrawingSegmentCommand}"
                                IsEnabled="{Binding !Owner.IsDrawingSegment}" />
                        <Button Classes="block" Content="Done tracing"
                                Command="{Binding Owner.FinishDrawingSegmentCommand}"
                                IsEnabled="{Binding Owner.IsDrawingSegment}" />
                        <Button Classes="block" Content="Flip which end is LED 1"
                                Command="{Binding Owner.FlipSegmentDirectionCommand}" />

                        <TextBlock Classes="hint" Foreground="#C9821B"
                                   IsVisible="{Binding !Segment.HasGeometry}"
                                   Text="No line on the photo yet, so it cannot be shown or clicked there." />

                        <TextBlock Classes="heading" Text="What kind of light" Margin="0,10,0,4" />

                        <ComboBox ItemsSource="{Binding Owner.FixtureStyles}"
                                  SelectedItem="{Binding Owner.FixtureChoice}"
                                  PlaceholderText="Pick a fixture"
                                  HorizontalAlignment="Stretch" />

                        <!-- "Aim the other way" used to live here. It was a second way of saying
                             "uplight": a downlight and an uplight aim at exactly opposite
                             perpendiculars and draw identically otherwise, so ticking it on one
                             always landed on the other. Picking the fixture says it once. -->
                        <StackPanel Spacing="4" IsVisible="{Binding Segment.Fixture.IsAimed}">
                          <TextBlock Classes="hint" Margin="0,6,0,0" Text="Beam spread" />
                          <Slider Minimum="10" Maximum="160"
                                  Value="{Binding Segment.Fixture.BeamAngleDegrees}" />
                          <TextBlock Classes="hint" Text="How far it reaches" />
                          <Slider Minimum="0.02" Maximum="0.6"
                                  Value="{Binding Segment.Fixture.ThrowLength}" />
                        </StackPanel>

                      </StackPanel>
                    </ScrollViewer>
                  </DockPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- ============ one LED output's own settings ============
                 These describe the strip rather than the layout - what order its chips want their
                 colours in, what one LED draws - so they go straight to the controller rather than
                 waiting for Save. Length is not here: that is the runs plugged in, added up. -->
            <ContentControl Content="{Binding EditingOutput}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:OutputGroup">
                  <DockPanel>

                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                      <Button HorizontalAlignment="Left" Padding="8,3"
                              Command="{Binding Owner.CloseOutputEditorCommand}">
                        <TextBlock Text="&#x2190;  All controllers" />
                      </Button>
                      <TextBlock Classes="panelTitle" Text="{Binding Header}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="hint" Text="{Binding Summary}" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="6" Margin="0,0,6,0">

                        <TextBlock Classes="hint" Text="Colour order" />
                        <ComboBox ItemsSource="{Binding Owner.ColorOrders}"
                                  SelectedItem="{Binding Owner.OutputColorOrder}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="If the reds and greens come out swapped, this is why. It is a property of the chips on that strip, so two outputs on one controller can want different answers - and on this house they do." />

                        <TextBlock Classes="hint" Text="Milliamps per LED" />
                        <TextBox Text="{Binding Owner.OutputMilliampsPerLed}" />
                        <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="What one LED is budgeted at, so the controller can hold the whole strip inside its power limit." />

                        <TextBlock Classes="hint" Text="Skip the first N LEDs" />
                        <TextBox Text="{Binding Owner.OutputSkipFirst}" />
                        <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="For LEDs at the near end that are wired but not wanted - hidden behind a downpipe, say." />

                        <!-- The output's own "reversed" flag is not offered. It says the same
                             physical thing as putting the runs in the other order and flipping
                             each one, except that those are visible in the panel and it is not -
                             and on an output with more than one run it also swaps which LEDs
                             belong to which run, which is not what anyone means by "the other
                             way round". -->

                        <CheckBox Content="Keep sending to it while it is off"
                                  IsChecked="{Binding Owner.OutputOffRefresh}" />
                        <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Normally the controller stops talking to a strip that is off. A few LED chips need to keep being told to stay dark, and glow faintly or pick up stray pixels when the line goes quiet. Leave it off unless you see that." />

                      </StackPanel>
                    </ScrollViewer>
                  </DockPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

          </Grid>
        </Border>

        <TabControl Margin="14,8,14,8">

          <TabItem Header="The house">
            <DockPanel>
              <!-- Tracing moved into the segment's own editor on the left, where the segment
                   being traced is named and the photo is not covered by anything. -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="4,8">
                <Button Content="Load photo" Click="OnLoadPhoto" />
                <Border Padding="8,3" CornerRadius="3" Background="#2F7BD6" VerticalAlignment="Center"
                        IsVisible="{Binding IsDrawingSegment}">
                  <TextBlock Text="Tracing" FontSize="12" Foreground="White" />
                </Border>
              </StackPanel>

              <!-- Says what a click does now, which is not the same in both modes. -->
              <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="4,0,4,8"
                         Text="{Binding PhotoHint}" />

              <ctrl:HouseCanvas Project="{Binding Project}"
                                Photo="{Binding PhotoBytes, Converter={x:Static vm:Converters.PhotoBitmap}}"
                                LayoutRevision="{Binding LayoutRevision}"
                                SelectedSegment="{Binding SelectedSegment}"
                                ControllerStates="{Binding ControllerStates}"
                                IsDrawing="{Binding IsDrawingSegment}"
                                PointAdded="OnCanvasPointAdded"
                                SegmentPicked="OnSegmentPicked" />
            </DockPanel>
          </TabItem>

          <!-- It spent a while under a "Health" heading next to the layout, which is a different
               question about different things, and then a while on the main screen, where it was the
               third thing anyone saw while being a check you run once in a while. A tab of its own in
               Setup is where a rarely-run question about the hardware belongs. It still says "preset"
               on purpose: this is about what is on the controllers, including what LedBalloon did not
               put there. -->
          <TabItem Header="Presets">
            <ScrollViewer>
              <StackPanel Margin="10,12" Spacing="6" MaxWidth="620" HorizontalAlignment="Left">

                <TextBlock Classes="heading" Text="What is on the controllers" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="A preset saved when you thought a segment was shorter puts that old length back when it is recalled, so the LEDs you found later stay dark. This reads every preset on every controller and lists the ones that would. Scenes cannot go wrong this way — they carry no LED numbers at all." />

                <Button Content="Check" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Command="{Binding AuditCommand}" />

                <ItemsControl ItemsSource="{Binding PresetGaps}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Classes="hint" Margin="0,2" TextWrapping="Wrap"
                                 Foreground="#C9821B" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Schedule">
            <DockPanel Margin="8,8,8,8">

              <StackPanel DockPanel.Dock="Top" Spacing="6">
                <!-- Same as Setup: the badge sits on the heading, clear of the buttons. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Timers" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Padding="6,1" CornerRadius="3" VerticalAlignment="Center"
                          Background="#33C9821B" BorderBrush="#C9821B" BorderThickness="1"
                          IsVisible="{Binding ScheduleChanged}">
                    <TextBlock Text="Unsaved" FontSize="11" Foreground="#C9821B" />
                  </Border>
                </StackPanel>
                <TextBlock Classes="hint"
                           Text="The controllers run this by themselves, with or without this app open. It is stored on them like everything else, so it survives reinstalling and it keeps going when the computer is off." />
                <TextBlock Classes="hint"
                           Text="One line per controller, because each box runs its own timetable. A scene only appears here once it has been saved — that is when it reaches the controllers, and a timer can only fire what its own box holds." />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,6">
                  <Button Content="Add a timer" Command="{Binding AddScheduleEntryCommand}" />
                  <Button Content="Save to controllers"
                          Command="{Binding SaveScheduleCommand}"
                          IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
              </StackPanel>

              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Schedule}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduleRow">
                      <Border Classes="card" Margin="0,0,0,6" Padding="10">
                        <StackPanel Spacing="6">

                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{Binding Enabled}" Content="On" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ControllerName}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Content="Remove" Padding="6,2"
                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveScheduleEntryCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>

                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <ComboBox ItemsSource="{Binding Triggers}"
                                      SelectedItem="{Binding Trigger}" Width="120" />
                            <NumericUpDown Value="{Binding Hour}" Minimum="0" Maximum="23"
                                           FormatString="00" ShowButtonSpinner="False" Width="52"
                                           IsVisible="{Binding IsClock}" />
                            <TextBlock Text=":" VerticalAlignment="Center"
                                       IsVisible="{Binding IsClock}" />
                            <NumericUpDown Value="{Binding Minute}" Minimum="0" Maximum="59"
                                           FormatString="00" ShowButtonSpinner="False" Width="52"
                                           IsVisible="{Binding IsClock}" />
                            <TextBlock Text="show" VerticalAlignment="Center" Classes="hint" />
                            <ComboBox ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding Preset}"
                                      PlaceholderText="pick a scene" MinWidth="200" />
                          </StackPanel>

                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </TabItem>


        </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
