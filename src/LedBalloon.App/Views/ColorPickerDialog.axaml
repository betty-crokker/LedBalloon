<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LedBalloon.App.ViewModels"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="LedBalloon.App.Views.ColorPickerDialog"
        x:DataType="vm:SegmentColorSlot"
        Icon="/Assets/ledballoon.ico"
        Title="LedBalloon"
        Width="372" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelBackground" Color="#F4F5F7" />
          <SolidColorBrush x:Key="PanelBorder" Color="#DFE1E5" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PanelBackground" Color="#16181C" />
          <SolidColorBrush x:Key="PanelBorder" Color="#2A2E35" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.panelTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <Border Padding="18" Background="{DynamicResource PanelBackground}">
    <StackPanel Spacing="10">

      <TextBlock Classes="panelTitle" Text="{Binding Label}" />

      <!-- What it was beside what it is becoming, big enough to actually read. The picker alone
           does not answer "did that do anything": the spectrum shows every hue at full brightness
           while the bar down its left side decides how bright the result is, so with that bar near
           the bottom every hue you click comes out as a near-black version of itself and the small
           swatch on the button barely moves. Two large patches side by side say it plainly. -->
      <Grid ColumnDefinitions="*,Auto,*" Margin="0,2,0,0">
        <Border Grid.Column="0" Height="46" CornerRadius="4"
                Background="{Binding OpenedBrush}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" />
        <TextBlock Grid.Column="1" Text="&#x2192;" FontSize="18" Margin="10,0"
                   VerticalAlignment="Center" Opacity="0.6" />
        <Border Grid.Column="2" Height="46" CornerRadius="4"
                Background="{Binding Brush}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto,*">
        <TextBlock Grid.Column="0" Classes="hint" Text="Old color" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="hint" Text="New color" />
          <TextBlock Classes="hint" Text="{Binding Hex}" FontFamily="Consolas,monospace" />
        </StackPanel>
      </Grid>

      <!-- Built from the two controls rather than dropped in as one ColorView, so each of them can
           say what it is. As a ColorView this was a square of every color with an unlabelled bar
           down either side, and the one on the left - brightness - is the one that decides whether
           anything you click in the square is visible at all. On a dark segment it sits near the
           bottom, so every hue comes out a near-black version of itself and the picker looks broken.
           Underneath and named, it reads in the order you use it.

           The bar that was down the right was alpha. An LED has no transparency and the alpha was
           dropped on the way to the controller regardless, so it could only mislead; it is gone
           rather than relabelled. -->
      <TextBlock Classes="hint" Text="Color" Margin="0,6,0,2" />
      <primitives:ColorSpectrum Height="308" Width="308" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="ColorWheel"
                                Components="HueSaturation"
                                HsvColor="{Binding Hsv, Mode=TwoWay}" />

      <TextBlock Classes="hint" Text="Brightness" Margin="0,10,0,2" />
      <primitives:ColorSlider Height="26" HorizontalAlignment="Stretch"
                              AutomationProperties.AutomationId="ColorBrightness"
                              Orientation="Horizontal"
                              ColorModel="Hsva"
                              ColorComponent="Component3"
                              IsAlphaVisible="False"
                              IsPerceptive="True"
                              HsvColor="{Binding Hsv, Mode=TwoWay}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
        <Button Content="Cancel" Click="OnCancel" IsCancel="True"
                AutomationProperties.AutomationId="ColorCancel" />
        <Button Content="OK" Click="OnAccept" IsDefault="True"
                AutomationProperties.AutomationId="ColorOk" />
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
