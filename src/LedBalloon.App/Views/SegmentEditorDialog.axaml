<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:vm="using:LedBalloon.App.ViewModels"
        xmlns:ctrl="using:LedBalloon.App.Controls"
        x:Class="LedBalloon.App.Views.SegmentEditorDialog"
        x:DataType="vm:MainViewModel"
        Title="LedBalloon"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <!-- Its own copies of the few styles and brushes it uses. They live in MainWindow, and a window
       is not inside another window's scope, so a class name borrowed from there would silently do
       nothing. Four styles is less to go wrong than moving the main window's whole sheet up to the
       application and finding out afterwards what else was reading it. -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelBackground" Color="#F4F5F7" />
          <SolidColorBrush x:Key="PanelBorder" Color="#DFE1E5" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PanelBackground" Color="#16181C" />
          <SolidColorBrush x:Key="PanelBorder" Color="#2A2E35" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.panelTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.block">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Border Padding="18" Background="{DynamicResource PanelBackground}">
    <DockPanel>

      <!-- Declared before the scroller so it keeps its room whatever is above it: the buttons are
           the way out and must not be the thing that scrolls off the bottom. -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                  HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Name="CancelButton" Content="Cancel" Click="OnCancel" IsCancel="True"
                AutomationProperties.AutomationId="SegmentCancel"
                ToolTip.Tip="Put this segment back the way it was when this opened" />
        <Button Name="SaveButton" Content="Save" Click="OnSave" IsDefault="True"
                AutomationProperties.AutomationId="SegmentSave" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
        <TextBlock Classes="panelTitle" Text="{Binding SelectionLabel}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="hint" Text="Changing any of these changes this scene." />
      </StackPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="560">
        <StackPanel Spacing="4" Margin="0,0,6,0">

          <!-- This run straightened out, with the last couple of seconds of it running downwards.
               One row - the run as it is this instant - is faithful and, for a good half of the
               effects, unreadable: Halloween Eyes on the porch line lights 8 LEDs out of 308 on
               about an eighth of frames, so the honest single row is black nearly all the time and
               reads as a control that is broken. Stacked frames catch the blink, and show movement
               besides: Chase comes out as diagonal bands whose slope is its speed. -->
          <!-- The scale down the side, because "the last few seconds downwards" in the caption
               says there is a time axis without saying which end of it is which - and a panel that
               is read the wrong way round is read as an effect running backwards. -->
          <Grid ColumnDefinitions="*,8,Auto">
            <ctrl:StripPreview Grid.Column="0" Height="92" Margin="0,0,0,4"
                               AutomationProperties.AutomationId="SegmentPreview"
                               Segment="{Binding PreviewSegment}"
                               LedCount="{Binding PreviewLedCount}"
                               EffectNames="{Binding PreviewEffectNames}"
                               Palette="{Binding PreviewPalette}"
                               Timing="{Binding PreviewTiming}" />

            <DockPanel Grid.Column="2" Height="92" Width="46">
              <TextBlock DockPanel.Dock="Top" Classes="hint" Text="now" FontSize="11" />
              <TextBlock DockPanel.Dock="Bottom" Classes="hint" Text="older" FontSize="11" />
              <TextBlock Text="&#x2193;" Classes="hint" FontSize="13"
                         HorizontalAlignment="Left" VerticalAlignment="Center" />
            </DockPanel>
          </Grid>

          <TextBlock Classes="hint" Text="{Binding SegmentPreviewCaption}" />

          <TextBlock Classes="hint" FontStyle="Italic" Margin="0,0,0,4"
                     Text="{Binding SegmentPreviewNote}"
                     IsVisible="{Binding SegmentPreviewNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- One box per color slot the effect actually reads, named the way the effect names it.
               A single box called "Color" was wrong twice over: most effects read more than one
               slot - Aurora reads three, Two Dots reads two and a background - and a good third of
               them read none at all. -->
          <ItemsControl ItemsSource="{Binding SegmentColors}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SegmentColorSlot">
                <!-- A window rather than a flyout hanging off the swatch. A flyout has no OK and
                     no Cancel: it applies as you drag and closes when you click elsewhere, so there
                     was no way to try a color and decide against it. -->
                <Button Padding="6,4" VerticalAlignment="Center" Margin="0,0,8,6"
                        AutomationProperties.AutomationId="SegmentColor"
                        Command="{Binding PickCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="22" Height="22" CornerRadius="4"
                            Background="{Binding Brush}"
                            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="hint" FontStyle="Italic" Margin="0,2,0,0"
                     Text="{Binding SegmentColorNote}"
                     IsVisible="{Binding SegmentColorNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <TextBlock Classes="hint" Margin="0,8,0,2" Text="Effect" />
          <!-- Each row carries a stamp of what that effect does on this segment, drawn the same
               way the preview above is: the run across, a few recent frames down. "Chunchun" is not
               a description and neither is "Phased Noise", and the list is 187 of them. -->
          <ComboBox ItemsSource="{Binding SegmentEffects}"
                    AutomationProperties.AutomationId="SegmentEffect"
                    SelectedItem="{Binding SegmentEffectChoice}"
                    PlaceholderText="Not reported yet"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PickerOption">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="72" Height="18" CornerRadius="2" VerticalAlignment="Center"
                          BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <Image Source="{Binding Preview}" Stretch="Fill"
                           RenderOptions.BitmapInterpolationMode="None" />
                  </Border>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- Off when the effect ignores it. Which is which comes from the port where there is one
               and from the controller's own fxdata otherwise, so a control that would do nothing is
               not offered. -->
          <TextBlock Classes="hint" Margin="0,8,0,2" Text="Palette" />
          <ComboBox ItemsSource="{Binding SegmentPalettes}"
                    AutomationProperties.AutomationId="SegmentPalette"
                    SelectedItem="{Binding SegmentPaletteChoice}"
                    IsEnabled="{Binding SegmentUsesPalette}"
                    PlaceholderText="Not reported yet"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteOption">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="48" Height="14" CornerRadius="3"
                          VerticalAlignment="Center"
                          Background="{Binding Gradient}"
                          BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                          IsVisible="{Binding HasGradient}" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Classes="hint" FontStyle="Italic" Margin="0,2,0,0"
                     Text="{Binding SegmentPaletteNote}"
                     IsVisible="{Binding SegmentPaletteNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- Under the effect's own names for them. Fire 2012 calls these "Cooling" and "Spark
               rate", which say what moving them does; an effect that ignores one does not get it. -->
          <StackPanel IsVisible="{Binding SegmentUsesSpeed}" Margin="0,8,0,0">
            <DockPanel>
              <TextBlock Classes="hint" DockPanel.Dock="Left" VerticalAlignment="Center"
                         Text="{Binding SegmentSpeedLabel}" Margin="0,0,8,0" />
              <TextBlock Classes="hint" DockPanel.Dock="Right" Width="30"
                         TextAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding SegmentSpeed, StringFormat={}{0:0}}" />
              <Slider Minimum="0" Maximum="255"
                      AutomationProperties.AutomationId="SegmentSpeed"
                      Value="{Binding SegmentSpeed, Mode=TwoWay}" />
            </DockPanel>
          </StackPanel>

          <StackPanel IsVisible="{Binding SegmentUsesIntensity}">
            <DockPanel>
              <TextBlock Classes="hint" DockPanel.Dock="Left" VerticalAlignment="Center"
                         Text="{Binding SegmentIntensityLabel}" Margin="0,0,8,0" />
              <TextBlock Classes="hint" DockPanel.Dock="Right" Width="30"
                         TextAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding SegmentIntensity, StringFormat={}{0:0}}" />
              <Slider Minimum="0" Maximum="255"
                      AutomationProperties.AutomationId="SegmentIntensity"
                      Value="{Binding SegmentIntensity, Mode=TwoWay}" />
            </DockPanel>
          </StackPanel>

          <!-- Naming is a promotion, not a requirement: most segments in most scenes are one-offs.
               It is in here because a look is one segment's appearance, and the segment it is taken
               from is the one this dialog is open on. -->
          <TextBlock Classes="heading" Text="Looks" />

          <TextBlock Classes="hint"
                     Text="A look is a named way for one segment to look — its effect, palette, speed and colors, written down once. Use it on as many segments and in as many scenes as you like; change it here and all of them follow." />

          <ComboBox ItemsSource="{Binding Looks}"
                    AutomationProperties.AutomationId="LookList"
                    SelectedItem="{Binding SelectedLook}"
                    DisplayMemberBinding="{Binding Name}"
                    PlaceholderText="Pick a look"
                    HorizontalAlignment="Stretch"
                    Margin="0,6,0,6" />

          <Button Classes="block" Content="Write this segment down as a look"
                  Command="{Binding NameThisLookCommand}" />

          <StackPanel Spacing="8" Margin="0,8,0,0"
                      IsVisible="{Binding SelectedLook, Converter={x:Static conv:ObjectConverters.IsNotNull}}">

            <TextBox Text="{Binding SelectedLook.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     AutomationProperties.AutomationId="LookName"
                     PlaceholderText="Look name" />

            <!-- The reach is the point and also the surprise, so it is said while the look is being
                 changed rather than afterwards. -->
            <TextBlock Classes="hint" Text="{Binding SelectedLook.Reach}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Put it on this segment" Command="{Binding ApplyLookCommand}" />
              <Button Content="Take it from this segment" Command="{Binding UpdateLookCommand}" />
              <Button Content="Remove" Command="{Binding DeleteLookCommand}" />
            </StackPanel>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>
</Window>
