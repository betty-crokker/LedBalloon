<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedBalloon.App.App"
             xmlns:local="using:LedBalloon.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- Fluent's own button fill is a mid grey carrying near-black text, and at this size the pair
         reads as a disabled control: low contrast, no edge, nothing to say it can be pressed. The
         fix is a white face and a border dark enough to draw the shape on its own - a near-white
         face alone is only a nineteen-level step from the #F4F5F7 panels and the #E9EBEF strip the
         buttons sit on, which reads as no button at all - a white face against that strip is only
         1.19:1, so the border carries the whole job and is sized to 3:1 against the face, the
         contrast a component boundary needs to be seen. And, just as much, a disabled state that
         is plainly different, since the complaint about an enabled button looking disabled is also
         a complaint that a disabled one looks like anything else.

         Here rather than in the main window, because every dialog is its own window and would not
         have inherited it. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F2F6FD" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E2E7EF" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#EDEEF1" />

                    <SolidColorBrush x:Key="ButtonForeground" Color="#16181C" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#16181C" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#16181C" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#A2A7B0" />

                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#8B939F" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#6B7480" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#6B7480" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#DCDFE4" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ButtonBackground" Color="#2E333B" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3A414B" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#232831" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#1C1F24" />

                    <SolidColorBrush x:Key="ButtonForeground" Color="#F0F2F5" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5C636E" />

                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#737C8A" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#949DAB" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#949DAB" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#2A2E35" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- The color controls ship their own theme; FluentTheme does not include it, and without
             this the ColorView silently renders as nothing at all. -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>
</Application>