<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedBalloon.App.App"
             xmlns:local="using:LedBalloon.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- Fluent's own button fill is a mid grey carrying near-black text, and at this size the pair
         reads as a disabled control: low contrast, no edge, nothing to say it can be pressed. The
         fix is not darker text but a lighter face and a border that holds a shape - and, just as
         much, a disabled state that is plainly different, since the complaint about an enabled
         button looking disabled is also a complaint that a disabled one looks like anything else.

         Here rather than in the main window, because every dialog is its own window and would not
         have inherited it. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FCFCFD" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F1F3F7" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E3E6EC" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#F2F3F5" />

                    <SolidColorBrush x:Key="ButtonForeground" Color="#16181C" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#16181C" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#16181C" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#A2A7B0" />

                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#BFC4CC" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#9AA1AB" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#9AA1AB" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#E4E6EA" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ButtonBackground" Color="#272B32" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#31363F" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1F2329" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#1C1F24" />

                    <SolidColorBrush x:Key="ButtonForeground" Color="#F0F2F5" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5C636E" />

                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3C434D" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#525A66" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#525A66" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#2A2E35" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- The color controls ship their own theme; FluentTheme does not include it, and without
             this the ColorView silently renders as nothing at all. -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>
</Application>