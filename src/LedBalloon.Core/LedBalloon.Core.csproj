<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LedBalloon.Core</RootNamespace>
    <AssemblyName>LedBalloon.Core</AssemblyName>

    <!-- The source-generated JSON context is what makes trimmed and AOT publishes safe. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <Description>A cross-platform .NET client for WLED: JSON over HTTP, live state over WebSocket, per-pixel streaming over UDP, and mDNS discovery.</Description>
    <PackageId>LedBalloon.Core</PackageId>
    <PackageTags>wled;led;ws2812;esp32;esp8266;lighting</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Managed mDNS, so discovery behaves the same without Bonjour on Windows or Avahi on Linux. -->
    <PackageReference Include="Zeroconf" Version="3.7.16" />

    <!-- Image decode and JPEG encode, so a photo can be shrunk to fit a controller's flash. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>


  <!--
    WLED's effect engine, built by native/build.ps1. It travels beside the app because
    NativeEngine loads it by name at run time; without it the app falls back to the ported
    effects in Effects/ and says so. Not checked in - it is a build output - so a clean clone
    builds and runs, just without the engine until build.ps1 has been run once.
  -->
  <PropertyGroup>
    <WledEngine>$(MSBuildThisFileDirectory)../../native/wledfx.dll</WledEngine>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(WledEngine)')">
    <None Include="$(WledEngine)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>wledfx.dll</Link>
    </None>
  </ItemGroup>

  <Target Name="WarnWithoutNativeEngine" BeforeTargets="Build" Condition="!Exists('$(WledEngine)')">
    <Warning Text="native/wledfx.dll is missing, so the app falls back to the ported effects. Build it with: pwsh native/build.ps1" />
  </Target>
</Project>
