<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:vm="using:Ledwright.App.ViewModels"
        xmlns:ctrl="using:Ledwright.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="Ledwright.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Ledwright"
        Width="1280" Height="820"
        MinWidth="1040" MinHeight="620">

  <Window.Resources>
    <ResourceDictionary>
      <!-- Defined per theme rather than hardcoded, so the app is legible whether the
           system is set to light or dark. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelBackground" Color="#F4F5F7" />
          <SolidColorBrush x:Key="PanelBorder" Color="#DFE1E5" />
          <SolidColorBrush x:Key="StatusBackground" Color="#E9EBEF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PanelBackground" Color="#16181C" />
          <SolidColorBrush x:Key="PanelBorder" Color="#2A2E35" />
          <SolidColorBrush x:Key="StatusBackground" Color="#1A1D22" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.panelTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.block">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Status bar. The hardware lives down here once it is working. -->
    <Border DockPanel.Dock="Bottom" Padding="12,7"
            Background="{DynamicResource StatusBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="hint" Margin="12,0,0,0"
                   Text="{Binding ControllerSummary}" />
        <Border DockPanel.Dock="Right" Margin="12,0,0,0" Padding="7,1" CornerRadius="3"
                Background="#C9821B"
                IsVisible="{Binding HasUnsavedChanges}">
          <TextBlock Text="Unsaved changes" FontSize="12" Foreground="White" />
        </Border>
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- The house, described as segments. This is what the user works with. -->
    <Border DockPanel.Dock="Left" Width="300" Padding="14"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0">
      <!-- Scrolled as one column: the editor is tall enough that docking it to the bottom starved
           the list of space and left no way to pick a different segment. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="0">

        <TextBlock Classes="panelTitle" Text="Segments" Margin="0,0,0,2" />
        <TextBlock Classes="hint" Margin="0,0,0,10"
                   Text="This list stays put. The tabs above switch what fills the rest of the window." />

        <Border Classes="card" IsVisible="{Binding !HasSegments}">
          <StackPanel Spacing="8">
            <TextBlock Text="Nothing described yet" FontWeight="SemiBold" />
            <TextBlock Classes="hint"
                       Text="A segment is one run of LEDs — the gable, the porch rail. Describe them once in Setup and you will not have to think about controllers again." />
            <Button Classes="block" Content="Go to Setup" Command="{Binding GoToSetupCommand}" />
          </StackPanel>
        </Border>

        <!-- What each controller has described, and what it has not. This is where a controller
             with outputs nobody has named yet becomes visible. -->
        <ItemsControl ItemsSource="{Binding Coverage}" Margin="0,0,0,10">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ControllerCoverage">
              <StackPanel Margin="0,0,0,8" Spacing="3">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Classes="hint" Text="{Binding Summary}" />
                <Button Classes="block" FontSize="12" Padding="6,3"
                        Content="Bring in its outputs as segments"
                        IsVisible="{Binding NeedsAttention}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ImportFromControllerCommand}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Capped so the editor below it always stays reachable on a short window. -->
        <ListBox ItemsSource="{Binding SegmentRows}"
                 SelectedItem="{Binding SelectedRow}"
                 Background="Transparent"
                 MaxHeight="190"
                 IsVisible="{Binding HasSegments}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SegmentRow">
              <StackPanel Margin="0,4" Spacing="2">
                <TextBlock Text="{Binding Segment.Name}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="hint">
                  <Run Text="{Binding Segment.Count}" /><Run Text=" LEDs  ·  on " /><Run Text="{Binding ControllerName}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Spacing="8" Margin="0,12,0,0"
                    IsVisible="{Binding HasSegments}">

          <!-- Editing the selected run. Correcting a length here is the whole point of the app,
               so it updates the list and the drawn lights as you type. -->
          <Border Classes="card"
                  IsVisible="{Binding SelectedSegment, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                <Run Text="Editing:" /><Run Text=" " /><Run Text="{Binding SelectedSegment.Name}" />
              </TextBlock>
              <TextBlock Classes="hint" Margin="0,0,0,4"
                         Text="Everything below changes the run selected above. Type to rename it or correct its length; the list and the photo update as you go." />

              <TextBlock Classes="hint" Text="Name" />
              <TextBox Text="{Binding SelectedSegment.Name}" />

              <Grid ColumnDefinitions="*,8,*">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Classes="hint" Text="LEDs" />
                  <TextBox Text="{Binding SelectedSegment.Count}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Classes="hint" Text="Starts at" />
                  <TextBox Text="{Binding SelectedSegment.Start}" />
                </StackPanel>
              </Grid>

              <TextBlock Classes="hint" Text="What kind of light" />
              <ComboBox ItemsSource="{Binding FixtureStyles}"
                        SelectedItem="{Binding FixtureChoice}"
                        PlaceholderText="Pick a fixture"
                        HorizontalAlignment="Stretch" />

              <!-- Only the aimed styles throw a cone worth shaping. -->
              <StackPanel Spacing="4" IsVisible="{Binding SelectedSegment.Fixture.IsAimed}">
                <TextBlock Classes="hint" Text="Beam spread" />
                <Slider Minimum="10" Maximum="160"
                        Value="{Binding SelectedSegment.Fixture.BeamAngleDegrees}" />
                <TextBlock Classes="hint" Text="How far it reaches" />
                <Slider Minimum="0.02" Maximum="0.6"
                        Value="{Binding SelectedSegment.Fixture.ThrowLength}" />
                <CheckBox Content="Aim the other way"
                          IsChecked="{Binding SelectedSegment.Fixture.FlipAim}" />
              </StackPanel>

              <TextBlock Classes="hint" Text="A lens every N LEDs" />
              <TextBox Text="{Binding SelectedSegment.Fixture.VisibleEvery}" />

              <Button Classes="block" Content="Flip which end is LED 1"
                      Command="{Binding FlipSegmentDirectionCommand}" />
              <TextBlock Classes="hint"
                         Text="The selected run shows a filled marker at LED 1 and a hollow one at its last LED." />

              <Button Classes="block" Content="Redraw it on the photo"
                      Command="{Binding RedrawSegmentCommand}" Margin="0,4,0,0" />

              <TextBlock Classes="hint" Text="Driven by" />
              <ComboBox ItemsSource="{Binding Devices}"
                        SelectedItem="{Binding SegmentController}"
                        DisplayMemberBinding="{Binding DisplayName}"
                        PlaceholderText="Not assigned"
                        HorizontalAlignment="Stretch" />

              <Button Classes="block" Content="Remove this segment"
                      Command="{Binding DeleteSegmentCommand}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <Button Classes="block" Content="Add a segment" Command="{Binding AddSegmentCommand}" />
          <Button Classes="block" Content="Re-lay end to end" Command="{Binding RepackSegmentsCommand}" />
          <Button Classes="block" Content="Push layout to controllers" Command="{Binding PushGeometryCommand}" />

          <Button Classes="block" Content="Save to controllers"
                  Command="{Binding SaveProjectCommand}" IsEnabled="{Binding !IsBusy}" />

          <Button Classes="block" Content="Overwrite the newer version anyway"
                  Command="{Binding OverwriteNewerRevisionCommand}"
                  IsVisible="{Binding SaveBlockedByNewerRevision}" />

          <TextBlock Classes="hint"
                     Text="Saving stores the layout on the controllers themselves, so anyone else on this network opens Ledwright and finds it already set up. Anything outstanding is saved when you close the window." />
        </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <TabControl Margin="14,8,14,8" SelectedIndex="{Binding ActiveTab}">

      <!-- 0: the house -->
      <TabItem Header="House">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="4,8">
            <Button Content="Load photo" Click="OnLoadPhoto" />
            <Button Content="Draw selected segment" Command="{Binding StartDrawingSegmentCommand}" />
            <Button Content="Done drawing" Command="{Binding FinishDrawingSegmentCommand}" />
          </StackPanel>

          <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="4,0,4,8"
                     Text="Load a photo of the house at dusk, pick a segment on the left, then click along that run on the photo — starting at the end where LED 1 is. Extra clicks follow a corner. Tell it what kind of light it is on the left and the preview lights the wall accordingly." />

          <ctrl:HouseCanvas Project="{Binding Project}"
                            Photo="{Binding PhotoBytes, Converter={x:Static vm:Converters.PhotoBitmap}}"
                            LayoutRevision="{Binding LayoutRevision}"
                            SelectedSegment="{Binding SelectedSegment}"
                            ControllerStates="{Binding ControllerStates}"
                            IsDrawing="{Binding IsDrawingSegment}"
                            PointAdded="OnCanvasPointAdded" />
        </DockPanel>
      </TabItem>

      <!-- 1: the lights -->
      <TabItem Header="Lights">
        <ScrollViewer>
          <StackPanel Margin="8,8,8,16" Spacing="4">

            <TextBlock Classes="heading" Text="The whole house" Margin="0,4,0,6" />
            <ToggleSwitch IsChecked="{Binding MasterOn}" OnContent="On" OffContent="Off" />
            <Slider Minimum="0" Maximum="255" Value="{Binding MasterBrightness}" />
            <TextBlock Classes="hint"
                       Text="Drag freely: updates are merged and paced before they reach the hardware." />

            <TextBlock Classes="heading" Text="Presets" />
            <TextBlock Classes="hint"
                       Text="Everything saved on your controllers, in one list. A preset stored on more than one of them is shown once." />
            <TextBlock Classes="hint" Margin="0,6,0,0"
                       IsVisible="{Binding Presets.Count, Converter={x:Static vm:Converters.IsEmpty}}"
                       Text="No presets found on any controller." />

            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,2" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Content="{Binding Name}"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ApplyPresetCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="heading" Text="Selected segment" />
            <TextBlock Classes="hint"
                       IsVisible="{Binding SelectedSegment, Converter={x:Static conv:ObjectConverters.IsNull}}"
                       Text="Pick a segment on the left to change its effect and palette." />

            <StackPanel Spacing="4"
                        IsVisible="{Binding SelectedSegment, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding SelectedSegment.Name}" FontWeight="SemiBold" />

              <TextBlock Classes="hint" Margin="0,8,0,2" Text="Effect" />
              <ComboBox ItemsSource="{Binding SegmentEffects}"
                        SelectedIndex="{Binding SegmentEffectIndex}"
                        PlaceholderText="Not connected"
                        HorizontalAlignment="Stretch" />

              <TextBlock Classes="hint" Margin="0,8,0,2" Text="Palette" />
              <ComboBox ItemsSource="{Binding SegmentPalettes}"
                        SelectedIndex="{Binding SegmentPaletteIndex}"
                        PlaceholderText="Not connected"
                        HorizontalAlignment="Stretch" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 2: the hardware, out of the way -->
      <TabItem Header="Setup">
        <ScrollViewer>
          <StackPanel Margin="8,8,8,16" Spacing="6">

            <TextBlock Classes="heading" Text="Controllers" Margin="0,4,0,6" />
            <TextBlock Classes="hint"
                       Text="Found over mDNS and filed by MAC address, so a controller that comes back on a different IP is still recognised." />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <Button Content="Scan the network" Command="{Binding ScanCommand}"
                      IsEnabled="{Binding !IsScanning}" />
              <TextBox Width="180" PlaceholderText="192.168.0.102" Text="{Binding ManualHost}" />
              <Button Content="Add by address" Command="{Binding AddManualCommand}" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Devices}"
                     SelectedItem="{Binding SelectedDevice}"
                     Margin="0,8,0,0" MaxHeight="180">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceViewModel">
                  <StackPanel Spacing="2" Margin="0,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                               Fill="{Binding IsConnected, Converter={x:Static vm:Converters.ConnectionBrush}}" />
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Classes="hint">
                      <Run Text="{Binding Host}" /><Run Text="  ·  " /><Run Text="{Binding Status}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Spacing="6" Margin="0,8,0,0"
                        IsVisible="{Binding SelectedDevice, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
              <TextBlock Classes="hint" Text="Name this controller" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="240" Text="{Binding ControllerNameEdit}" PlaceholderText="Front of house" />
                <Button Content="Rename" Command="{Binding RenameControllerCommand}" />
                <Button Content="Also rename on the controller" Command="{Binding PushControllerNameCommand}" />
              </StackPanel>
              <TextBlock Classes="hint"
                         Text="Renaming stores the name in this project. Writing it to the controller makes it show in the WLED app too, and briefly interrupts the device." />
            </StackPanel>

            <TextBlock Classes="heading" Text="Describe the house" />
            <TextBlock Classes="hint"
                       Text="Each preset on a controller stores its own copy of the segment bounds, so they can disagree with each other. Working the layout out from presets weighs them against the hardware and asks you about the rest." />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <Button Content="Import outputs from selected controller"
                      Command="{Binding ImportSegmentsFromDeviceCommand}" />
              <Button Content="Work out layout from its presets"
                      Command="{Binding ProposeLayoutCommand}" />
            </StackPanel>

            <TextBlock Classes="heading" Text="Health" />
            <Button Content="Check presets against the strips"
                    Command="{Binding AuditCommand}" HorizontalAlignment="Left" />

            <ItemsControl ItemsSource="{Binding PresetGaps}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,2" TextWrapping="Wrap" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding LayoutProblems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,2" TextWrapping="Wrap" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding LayoutConflicts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,2" TextWrapping="Wrap" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
