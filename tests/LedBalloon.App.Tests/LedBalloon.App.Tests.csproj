    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LedBalloon.App\LedBalloon.App.csproj" />
  </ItemGroup>

</Project>
