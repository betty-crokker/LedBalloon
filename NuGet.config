<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Ledwright only needs nuget.org. <clear /> drops any feeds inherited from the machine-wide
    config (a private Thorlabs Azure Artifacts feed, for one) so a clone builds anywhere,
    including on a CI runner that has no credentials for them.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
